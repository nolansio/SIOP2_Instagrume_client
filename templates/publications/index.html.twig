{% extends 'base.html.twig' %}

{% block title %}Toutes les publications - Instagrume{% endblock %}

{% block body %}
<section class="py-5">
    <div class="container">
        {# Header avec recherche #}
        <div class="row mb-5 align-items-center animate-on-scroll">
            <div class="col-md-6">
                <h1 class="display-5 fw-bold mb-3">
                    Toutes les <span class="text-primary-custom">publications</span>
                </h1>
                <p class="text-muted mb-0">
                    Explorez les créations de notre communauté passionnée
                </p>
            </div>
            <div class="col-md-6">
                <div class="search-wrapper ms-auto">
                    <i class="search-icon bi bi-search"></i>
                    <input 
                        type="text" 
                        class="search-input" 
                        id="searchInput"
                        placeholder="Rechercher un utilisateur...">
                </div>
            </div>
        </div>

        {# Filtres #}
        <div class="d-flex gap-3 mb-4 flex-wrap animate-on-scroll stagger-1">
            <button class="btn btn-primary active" data-filter="all">
                <i class="bi bi-grid"></i> Toutes
            </button>
            <button class="btn btn-outline-primary" data-filter="recent">
                <i class="bi bi-clock-history"></i> Récentes
            </button>
            <button class="btn btn-outline-primary" data-filter="popular">
                <i class="bi bi-heart"></i> Populaires
            </button>
        </div>

        {# Grille de publications #}
        {% if publications is not empty %}
            <div class="row g-4" id="publicationsGrid">
                {% for publication in publications %}
                    <div class="col-lg-4 col-md-6 animate-on-scroll stagger-{{ loop.index % 3 }}" 
                         data-username="{{ publication.user.username|lower }}">
                        <article class="card h-100">
                            {# Image #}
                            {% if publication.images is not empty %}
                                <a href="{{ path('app_publication_show', {id: publication.id}) }}">
                                    <img src="{{ 'http://127.0.0.1:3000' ~ publication.images[0].url }}" 
                                         class="card-img-top" 
                                         alt="{{ publication.description|slice(0, 50) }}"
                                         loading="lazy">
                                </a>
                            {% else %}
                                <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 280px;">
                                    <i class="bi bi-image text-muted" style="font-size: 4rem;"></i>
                                </div>
                            {% endif %}

                            <div class="card-body">
                                {# User info #}
                                <div class="d-flex align-items-center mb-3">
                                    {% if publication.user.images is defined and publication.user.images is not empty %}
                                        <img src="{{ 'http://127.0.0.1:3000' ~ publication.user.images[0].url }}" 
                                             alt="{{ publication.user.username }}"
                                             class="avatar me-2">
                                    {% else %}
                                        <div class="avatar me-2 bg-primary-custom d-flex align-items-center justify-content-center text-white">
                                            {{ publication.user.username|slice(0, 1)|upper }}
                                        </div>
                                    {% endif %}
                                    <div class="flex-grow-1">
                                        <strong>{{ publication.user.username }}</strong>
                                        <br>
                                        <small class="text-muted">
                                            <i class="bi bi-clock"></i>
                                            {{ publication.created_at|date('d/m/Y') }}
                                        </small>
                                    </div>
                                    
                                    {# Badge modérateur si applicable #}
                                    {% if 'ROLE_MOD' in publication.user.roles or 'ROLE_ADMIN' in publication.user.roles %}
                                        <span class="badge bg-warning">
                                            <i class="bi bi-shield-check"></i> Mod
                                        </span>
                                    {% endif %}
                                </div>

                                {# Description #}
                                <p class="card-text">
                                    {{ publication.description|length > 120 
                                        ? publication.description|slice(0, 120) ~ '...' 
                                        : publication.description }}
                                </p>

                                {# Actions #}
                                <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                                    <div class="d-flex gap-3">
                                        <span class="text-muted">
                                            <i class="bi bi-heart-fill text-danger"></i> {{ publication.likes|length }}
                                        </span>
                                        <span class="text-muted">
                                            <i class="bi bi-chat-fill text-primary"></i> {{ publication.comments|length }}
                                        </span>
                                    </div>
                                    <a href="{{ path('app_publication_show', {id: publication.id}) }}" 
                                       class="btn btn-sm btn-primary">
                                        <i class="bi bi-eye"></i> Voir
                                    </a>
                                </div>
                            </div>
                        </article>
                    </div>
                {% endfor %}
            </div>

            {# Pagination (à implémenter) #}
            <div class="d-flex justify-content-center mt-5">
                <nav>
                    <ul class="pagination">
                        <li class="page-item disabled">
                            <a class="page-link" href="#" tabindex="-1">Précédent</a>
                        </li>
                        <li class="page-item active"><a class="page-link" href="#">1</a></li>
                        <li class="page-item"><a class="page-link" href="#">2</a></li>
                        <li class="page-item"><a class="page-link" href="#">3</a></li>
                        <li class="page-item">
                            <a class="page-link" href="#">Suivant</a>
                        </li>
                    </ul>
                </nav>
            </div>
        {% else %}
            {# Empty state #}
            <div class="text-center py-5">
                <i class="bi bi-inbox" style="font-size: 5rem; color: var(--color-grey-light);"></i>
                <h3 class="mt-4 mb-3">Aucune publication trouvée</h3>
                <p class="text-muted mb-4">
                    Soyez le premier à partager vos fruits et légumes !
                </p>
                <a href="{{ path('app_publication_new') }}" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> Créer une publication
                </a>
            </div>
        {% endif %}
    </div>
</section>

<style>
    .pagination .page-link {
        color: var(--color-primary);
        border: 2px solid var(--color-grey-light);
        border-radius: 8px;
        margin: 0 0.2rem;
        font-weight: 600;
    }
    
    .pagination .page-item.active .page-link {
        background-color: var(--color-primary);
        border-color: var(--color-primary);
    }
    
    .pagination .page-link:hover {
        background-color: var(--color-light);
        color: var(--color-primary);
    }
</style>

<script>
    // Recherche en temps réel
    const searchInput = document.getElementById('searchInput');
    const publicationsGrid = document.getElementById('publicationsGrid');
    
    if (searchInput && publicationsGrid) {
        searchInput.addEventListener('input', function(e) {
            const searchTerm = e.target.value.toLowerCase();
            const publications = publicationsGrid.querySelectorAll('[data-username]');
            
            publications.forEach(pub => {
                const username = pub.dataset.username;
                if (username.includes(searchTerm)) {
                    pub.style.display = '';
                } else {
                    pub.style.display = 'none';
                }
            });
        });
    }
    
    // Filtres
    const filterButtons = document.querySelectorAll('[data-filter]');
    
    filterButtons.forEach(button => {
        button.addEventListener('click', function() {
            // Update active state
            filterButtons.forEach(btn => btn.classList.remove('active', 'btn-primary'));
            filterButtons.forEach(btn => btn.classList.add('btn-outline-primary'));
            this.classList.remove('btn-outline-primary');
            this.classList.add('btn-primary', 'active');
            
            // TODO: Implement actual filtering logic
            console.log('Filter by:', this.dataset.filter);
        });
    });
</script>
{% endblock %}
