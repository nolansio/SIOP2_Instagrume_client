{% extends 'base.html.twig' %}

{% block title %}Dashboard Modération - Instagrume{% endblock %}

{% block body %}
<div class="container-fluid">
    <h1 class="mb-4">
        <i class="bi bi-shield-check text-warning"></i> Dashboard de Modération
    </h1>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {% for message in app.flashes('danger') %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    <div class="row">
        {# Section Utilisateurs #}
        <div class="col-md-6 mb-4">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-people"></i> Gestion des Utilisateurs
                    </h5>
                </div>
                <div class="card-body">
                    {% if users is not empty %}
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Utilisateur</th>
                                        <th>Rôle</th>
                                        <th>Statut</th>
                                        <th>Banni jusqu'au</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for user in users %}
                                        {# Ne pas afficher les admins et modérateurs dans la liste #}
                                        {% if 'ROLE_ADMIN' not in user.roles and 'ROLE_MOD' not in user.roles %}
                                            <tr>
                                                <td>
                                                    <a href="{{ path('app_user_profile', {username: user.username}) }}" 
                                                       class="text-decoration-none">
                                                        {{ user.username }}
                                                    </a>
                                                </td>
                                                <td>
                                                    {% if 'ROLE_ADMIN' in user.roles %}
                                                        <span class="badge bg-danger">Admin</span>
                                                    {% elseif 'ROLE_MOD' in user.roles %}
                                                        <span class="badge bg-warning">Modérateur</span>
                                                    {% else %}
                                                        <span class="badge bg-secondary">Utilisateur</span>
                                                    {% endif %}
                                                </td>
                                                <td>
                                                    {% if is_banned(user) %}
                                                        <span class="badge bg-danger">Banni</span>
                                                    {% else %}
                                                        <span class="badge bg-success">Actif</span>
                                                    {% endif %}
                                                </td>
                                                <td>
                                                    {% if is_banned(user) and user.banned_until %}
                                                        {{ user.banned_until|date('d/m/Y H:i') }}
                                                    {% else %}
                                                        <span class="text-muted">-</span>
                                                    {% endif %}
                                                </td>
                                                <td>
                                                    {% if is_banned(user) %}
                                                        <form method="post" action="{{ path('app_moderation_unban', {id: user.id}) }}" class="d-inline">
                                                            <button type="submit" class="btn btn-sm btn-success">
                                                                <i class="bi bi-check-circle"></i> Débannir
                                                            </button>
                                                        </form>
                                                    {% else %}
                                                        {# Bouton qui ouvre le modal #}
                                                        <button type="button" class="btn btn-sm btn-danger" 
                                                                data-bs-toggle="modal" 
                                                                data-bs-target="#banModal{{ user.id }}">
                                                            <i class="bi bi-x-circle"></i> Bannir
                                                        </button>

                                                        {# Modal pour choisir la durée #}
                                                        <div class="modal fade" id="banModal{{ user.id }}" tabindex="-1" aria-labelledby="banModalLabel{{ user.id }}" aria-hidden="true">
                                                            <div class="modal-dialog">
                                                                <div class="modal-content">
                                                                    <div class="modal-header bg-danger text-white">
                                                                        <h5 class="modal-title" id="banModalLabel{{ user.id }}">
                                                                            <i class="bi bi-exclamation-triangle"></i> Bannir {{ user.username }}
                                                                        </h5>
                                                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                                    </div>
                                                                    <form method="post" action="{{ path('app_moderation_ban', {id: user.id}) }}">
                                                                        <div class="modal-body">
                                                                            <div class="alert alert-warning">
                                                                                <i class="bi bi-info-circle"></i> 
                                                                                Vous êtes sur le point de bannir <strong>{{ user.username }}</strong>
                                                                            </div>
                                                                            
                                                                            <div class="mb-3">
                                                                                <label for="ban_duration{{ user.id }}" class="form-label">
                                                                                    <i class="bi bi-calendar"></i> Durée du bannissement (en jours)
                                                                                </label>
                                                                                <input type="number" 
                                                                                       class="form-control" 
                                                                                       id="ban_duration{{ user.id }}" 
                                                                                       name="ban_duration" 
                                                                                       min="1" 
                                                                                       max="365" 
                                                                                       value="7" 
                                                                                       required>
                                                                                <div class="form-text">
                                                                                    Minimum : 1 jour - Maximum : 365 jours (1 an)
                                                                                </div>
                                                                            </div>

                                                                            <div class="mb-3">
                                                                                <label class="form-label">Durées prédéfinies :</label>
                                                                                <div class="btn-group w-100" role="group">
                                                                                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="document.getElementById('ban_duration{{ user.id }}').value = 1">1 jour</button>
                                                                                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="document.getElementById('ban_duration{{ user.id }}').value = 7">7 jours</button>
                                                                                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="document.getElementById('ban_duration{{ user.id }}').value = 30">30 jours</button>
                                                                                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="document.getElementById('ban_duration{{ user.id }}').value = 365">1 an</button>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                        <div class="modal-footer">
                                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                                                                <i class="bi bi-x"></i> Annuler
                                                                            </button>
                                                                            <button type="submit" class="btn btn-danger">
                                                                                <i class="bi bi-ban"></i> Confirmer le bannissement
                                                                            </button>
                                                                        </div>
                                                                    </form>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        {# Script pour calculer la date de fin #}
                                                        <script>
                                                            (function() {
                                                                const input = document.getElementById('ban_duration{{ user.id }}');
                                                                const dateSpan = document.getElementById('ban_end_date{{ user.id }}');
                                                                
                                                                function updateEndDate() {
                                                                    const days = parseInt(input.value) || 0;
                                                                    const now = new Date();
                                                                    const endDate = new Date(now.getTime() + (days * 24 * 60 * 60 * 1000));
                                                                    
                                                                    const options = { 
                                                                        year: 'numeric', 
                                                                        month: 'long', 
                                                                        day: 'numeric',
                                                                        hour: '2-digit',
                                                                        minute: '2-digit'
                                                                    };
                                                                    dateSpan.textContent = endDate.toLocaleDateString('fr-FR', options);
                                                                }
                                                                
                                                                input.addEventListener('input', updateEndDate);
                                                                updateEndDate();
                                                            })();
                                                        </script>
                                                    {% endif %}
                                                </td>
                                            </tr>
                                        {% endif %}
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <p class="text-muted text-center">Aucun utilisateur à modérer.</p>
                    {% endif %}
                </div>
            </div>
        </div>

        {# Section Publications #}
        <div class="col-md-6 mb-4">
            <div class="card shadow">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">
                        <i class="bi bi-file-earmark-lock"></i> Gestion des Publications
                    </h5>
                </div>
                <div class="card-body">
                    {% if publications is not empty %}
                        <div class="list-group">
                            {% for publication in publications %}
                                <div class="list-group-item">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div class="flex-grow-1">
                                            <h6 class="mb-1">
                                                <a href="{{ path('app_publication_show', {id: publication.id}) }}" 
                                                   class="text-decoration-none">
                                                    Publication #{{ publication.id }}
                                                </a>
                                            </h6>
                                            <p class="mb-1 text-muted">
                                                Par <strong>{{ publication.user.username }}</strong>
                                            </p>
                                            <small class="text-muted">
                                                {{ publication.createdAt|date('d/m/Y H:i') }}
                                            </small>
                                            {% if publication.locked %}
                                                <span class="badge bg-danger ms-2">Verrouillée</span>
                                            {% endif %}
                                        </div>
                                        <div class="ms-3">
                                            {% if publication.locked %}
                                                <form method="post" action="{{ path('app_publication_unlock', {id: publication.id}) }}">
                                                    <button type="submit" class="btn btn-sm btn-success">
                                                        <i class="bi bi-unlock"></i> Déverrouiller
                                                    </button>
                                                </form>
                                            {% else %}
                                                <form method="post" action="{{ path('app_publication_lock', {id: publication.id}) }}">
                                                    <button type="submit" class="btn btn-sm btn-warning">
                                                        <i class="bi bi-lock"></i> Verrouiller
                                                    </button>
                                                </form>
                                            {% endif %}
                                            
                                            {# Modérateur peut supprimer les publications des utilisateurs normaux #}
                                            {% if 'ROLE_ADMIN' not in publication.user.roles and 'ROLE_MOD' not in publication.user.roles %}
                                                <form method="post" action="{{ path('app_publication_delete', {id: publication.id}) }}" class="mt-1">
                                                    <button type="submit" class="btn btn-sm btn-danger"
                                                            onclick="return confirm('Supprimer cette publication ?')">
                                                        <i class="bi bi-trash"></i> Supprimer
                                                    </button>
                                                </form>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <p class="text-muted text-center">Aucune publication à modérer.</p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <div class="text-center mt-3">
        <a href="{{ path('app_home') }}" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Retour à l'accueil
        </a>
    </div>
</div>
{% endblock %}
