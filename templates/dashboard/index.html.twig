{% extends 'base.html.twig' %}

{% block title %}Dashboard Modération - Instagrume{% endblock %}

{% block body %}
<div class="container-fluid">
    <h1 class="mb-4">
        <i class="bi bi-shield-check text-warning"></i> Dashboard de Modération
    </h1>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {% for message in app.flashes('danger') %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    <div class="row">
        {# Section Utilisateurs #}
        <div class="col-md-6 mb-4">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-people"></i> Gestion des Utilisateurs
                    </h5>
                </div>
                <div class="card-body">
                    {% if users is not empty %}
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Utilisateur</th>
                                        <th>Rôle</th>
                                        <th>Statut</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for user in users %}
                                        {# Ne pas afficher les admins et modérateurs dans la liste (ils ne peuvent pas être bannis) #}
                                        {% if 'ROLE_ADMIN' not in user.roles and 'ROLE_MOD' not in user.roles %}
                                            <tr>
                                                <td>
                                                    <a href="{{ path('app_user_profile', {username: user.username}) }}" 
                                                       class="text-decoration-none">
                                                        {{ user.username }}
                                                    </a>
                                                </td>
                                                <td>
                                                    {% if 'ROLE_ADMIN' in user.roles %}
                                                        <span class="badge bg-danger">Admin</span>
                                                    {% elseif 'ROLE_MOD' in user.roles %}
                                                        <span class="badge bg-warning">Modérateur</span>
                                                    {% else %}
                                                        <span class="badge bg-secondary">Utilisateur</span>
                                                    {% endif %}
                                                </td>
                                                <td>
                                                    {% if is_banned(user) %}
                                                        <span class="badge bg-danger">Banni</span>
                                                    {% else %}
                                                        <span class="badge bg-success">Actif</span>
                                                    {% endif %}
                                                </td>
                                                <td>
                                                    {% if is_banned(user) %}
                                                        <form method="post" action="{{ path('app_moderation_unban', {id: user.id}) }}" class="d-inline">
                                                            <button type="submit" class="btn btn-sm btn-success">
                                                                <i class="bi bi-check-circle"></i> Débannir
                                                            </button>
                                                        </form>
                                                    {% else %}
                                                        <form method="post" action="{{ path('app_moderation_ban', {id: user.id}) }}" class="d-inline">
                                                            <button type="submit" class="btn btn-sm btn-danger"
                                                                    onclick="return confirm('Bannir cet utilisateur ?')">
                                                                <i class="bi bi-x-circle"></i> Bannir
                                                            </button>
                                                        </form>
                                                    {% endif %}
                                                </td>
                                            </tr>
                                        {% endif %}
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <p class="text-muted text-center">Aucun utilisateur à modérer.</p>
                    {% endif %}
                </div>
            </div>
        </div>

        {# Section Publications #}
        <div class="col-md-6 mb-4">
            <div class="card shadow">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">
                        <i class="bi bi-file-earmark-lock"></i> Gestion des Publications
                    </h5>
                </div>
                <div class="card-body">
                    {% if publications is not empty %}
                        <div class="list-group">
                            {% for publication in publications %}
                                <div class="list-group-item">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div class="flex-grow-1">
                                            <h6 class="mb-1">
                                                <a href="{{ path('app_publication_view', {id: publication.id}) }}" 
                                                   class="text-decoration-none">
                                                    Publication #{{ publication.id }}
                                                </a>
                                            </h6>
                                            <p class="mb-1 text-truncate">{{ publication.description|slice(0, 100) }}...</p>
                                            <small class="text-muted">
                                                Par {{ publication.user.username }} - 
                                                {{ publication.created_at|date('d/m/Y') }}
                                            </small>
                                            {% if publication.is_locked %}
                                                <span class="badge bg-danger ms-2">
                                                    <i class="bi bi-lock"></i> Verrouillée
                                                </span>
                                            {% endif %}
                                        </div>
                                        <div class="btn-group-vertical">
                                            {% if publication.is_locked %}
                                                <form method="post" action="{{ path('app_publication_unlock', {id: publication.id}) }}">
                                                    <button type="submit" class="btn btn-sm btn-success">
                                                        <i class="bi bi-unlock"></i> Déverrouiller
                                                    </button>
                                                </form>
                                            {% else %}
                                                <form method="post" action="{{ path('app_publication_lock', {id: publication.id}) }}">
                                                    <button type="submit" class="btn btn-sm btn-warning">
                                                        <i class="bi bi-lock"></i> Verrouiller
                                                    </button>
                                                </form>
                                            {% endif %}
                                            
                                            {# Modérateur peut supprimer les publications des utilisateurs normaux #}
                                            {% if 'ROLE_ADMIN' not in publication.user.roles and 'ROLE_MOD' not in publication.user.roles %}
                                                <form method="post" action="{{ path('app_publication_delete', {id: publication.id}) }}" class="mt-1">
                                                    <button type="submit" class="btn btn-sm btn-danger"
                                                            onclick="return confirm('Supprimer cette publication ?')">
                                                        <i class="bi bi-trash"></i> Supprimer
                                                    </button>
                                                </form>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <p class="text-muted text-center">Aucune publication à modérer.</p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <div class="text-center mt-3">
        <a href="{{ path('app_home') }}" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Retour à l'accueil
        </a>
    </div>
</div>
{% endblock %}
