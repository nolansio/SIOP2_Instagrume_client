{% extends 'base.html.twig' %}

{% block title %}Dashboard - Instagrume{% endblock %}

{% block body %}
<h1 class="mb-4">
    <i class="bi bi-speedometer2"></i> Dashboard Modération
</h1>

{# Onglets #}
<ul class="nav nav-tabs mb-4" id="dashboardTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="users-tab" data-bs-toggle="tab" data-bs-target="#users" type="button">
            <i class="bi bi-people"></i> Utilisateurs
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="publications-tab" data-bs-toggle="tab" data-bs-target="#publications" type="button">
            <i class="bi bi-image"></i> Publications
        </button>
    </li>
</ul>

<div class="tab-content" id="dashboardTabContent">
    {# Onglet Utilisateurs #}
    <div class="tab-pane fade show active" id="users" role="tabpanel">
        <h3 class="mb-3">Gestion des utilisateurs</h3>
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nom d'utilisateur</th>
                        <th>Rôle</th>
                        <th>Publications</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                        <tr>
                            <td>{{ user.id }}</td>
                            <td>
                                <a href="{{ path('app_user_profile', {username: user.username}) }}">
                                    {{ user.username }}
                                </a>
                            </td>
                            <td>
                                {% if 'ROLE_ADMIN' in user.roles %}
                                    <span class="badge bg-danger">Admin</span>
                                {% elseif 'ROLE_MOD' in user.roles %}
                                    <span class="badge bg-warning">Modérateur</span>
                                {% else %}
                                    <span class="badge bg-secondary">Utilisateur</span>
                                {% endif %}
                            </td>
                            <td>{{ user.publications|length }}</td>
                            <td>
                                {% if user.is_banned %}
                                    <span class="badge bg-dark">Banni</span>
                                {% else %}
                                    <span class="badge bg-success">Actif</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if user.username != currentUser.username %}
                                    {% if user.is_banned %}
                                        <form method="post" action="{{ path('app_user_deban', {id: user.id}) }}" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-success">
                                                <i class="bi bi-unlock"></i> Débannir
                                            </button>
                                        </form>
                                    {% else %}
                                        {% if 'ROLE_ADMIN' not in user.roles %}
                                            <form method="post" action="{{ path('app_user_ban', {id: user.id}) }}" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-danger"
                                                        onclick="return confirm('Bannir {{ user.username }} ?')">
                                                    <i class="bi bi-lock"></i> Bannir
                                                </button>
                                            </form>
                                        {% endif %}
                                    {% endif %}
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {# Onglet Publications #}
    <div class="tab-pane fade" id="publications" role="tabpanel">
        <h3 class="mb-3">Gestion des publications</h3>
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Auteur</th>
                        <th>Description</th>
                        <th>Date</th>
                        <th>Likes</th>
                        <th>Commentaires</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for publication in publications %}
                        <tr>
                            <td>{{ publication.id }}</td>
                            <td>
                                <a href="{{ path('app_user_profile', {username: publication.user.username}) }}">
                                    {{ publication.user.username }}
                                </a>
                            </td>
                            <td>{{ publication.description|slice(0, 50) }}{% if publication.description|length > 50 %}...{% endif %}</td>
                            <td>{{ publication.created_at|date('d/m/Y') }}</td>
                            <td>{{ publication.likes|length }}</td>
                            <td>{{ publication.comments|length }}</td>
                            <td>
                                {% if publication.is_locked %}
                                    <span class="badge bg-warning">Verrouillé</span>
                                {% else %}
                                    <span class="badge bg-success">Actif</span>
                                {% endif %}
                            </td>
                            <td>
                                <a href="{{ path('app_publication_view', {id: publication.id}) }}" class="btn btn-sm btn-primary">
                                    <i class="bi bi-eye"></i>
                                </a>
                                {% if publication.is_locked %}
                                    <form method="post" action="{{ path('app_publication_unlock', {id: publication.id}) }}" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-success">
                                            <i class="bi bi-unlock"></i>
                                        </button>
                                    </form>
                                {% else %}
                                    <form method="post" action="{{ path('app_publication_lock', {id: publication.id}) }}" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-warning">
                                            <i class="bi bi-lock"></i>
                                        </button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}