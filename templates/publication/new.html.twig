{% extends 'base.html.twig' %}

{% block title %}Nouvelle publication - Instagrume{% endblock %}

{% block body %}
<section class="py-5 bg-light-custom">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="text-center mb-5 animate-on-scroll">
                    <i class="bi bi-camera" style="font-size: 4rem; color: var(--color-primary);"></i>
                    <h1 class="display-5 fw-bold mt-3 mb-2">Partagez votre récolte</h1>
                    <p class="text-muted">Montrez-nous vos plus beaux fruits et légumes !</p>
                </div>

                <div class="card shadow-lg border-0 animate-on-scroll stagger-1" style="border-radius: 20px;">
                    <div class="card-body p-5">
                        <form method="post" enctype="multipart/form-data" id="publicationForm">
                            {# Zone de prévisualisation des images #}
                            <div class="mb-4">
                                <label class="form-label fw-semibold">
                                    <i class="bi bi-images"></i> Photos
                                </label>
                                
                                <div id="imagePreview" class="row g-3 mb-3"></div>
                                
                                <div class="upload-zone p-5 text-center border-2 border-dashed rounded-3" 
                                     style="border-color: var(--color-grey-light); background: var(--color-white); cursor: pointer;"
                                     onclick="document.getElementById('images').click()">
                                    <i class="bi bi-cloud-upload" style="font-size: 3rem; color: var(--color-primary);"></i>
                                    <p class="mb-0 mt-3">
                                        <strong>Cliquez pour ajouter des photos</strong>
                                        <br>
                                        <small class="text-muted">ou glissez-déposez vos images ici</small>
                                    </p>
                                </div>
                                
                                <input 
                                    type="file" 
                                    name="images[]" 
                                    id="images" 
                                    class="d-none"
                                    accept="image/*"
                                    multiple
                                    required>
                                <small class="form-text text-muted">
                                    Formats acceptés : JPG, PNG, WEBP. Taille max : 5 Mo par image.
                                </small>
                            </div>

                            {# Description #}
                            <div class="mb-4">
                                <label for="description" class="form-label fw-semibold">
                                    <i class="bi bi-pencil"></i> Description
                                </label>
                                <textarea 
                                    name="description" 
                                    id="description" 
                                    class="form-control form-control-lg" 
                                    rows="5"
                                    required
                                    placeholder="Parlez-nous de votre récolte, de vos techniques de culture, de vos recettes préférées..."
                                    style="border-radius: 12px; border: 2px solid var(--color-grey-light);"></textarea>
                                <div class="d-flex justify-content-between mt-2">
                                    <small class="form-text text-muted">
                                        Soyez descriptif et inspirant !
                                    </small>
                                    <small id="charCount" class="text-muted">0 caractères</small>
                                </div>
                            </div>

                            {# Boutons d'action #}
                            <div class="d-flex gap-3 justify-content-end">
                                <a href="{{ path('app_home') }}" class="btn btn-outline-secondary btn-lg">
                                    <i class="bi bi-x-circle"></i> Annuler
                                </a>
                                <button type="submit" class="btn btn-primary btn-lg">
                                    <i class="bi bi-check-circle"></i> Publier
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <div class="text-center mt-4">
                    <div class="card border-0 bg-primary-custom text-white p-4" style="border-radius: 16px;">
                        <h5 class="mb-3">
                            <i class="bi bi-lightbulb"></i> Conseils pour une belle publication
                        </h5>
                        <div class="row text-start">
                            <div class="col-md-6 mb-3">
                                <i class="bi bi-check-circle me-2"></i>
                                Photographiez avec une bonne lumière naturelle
                            </div>
                            <div class="col-md-6 mb-3">
                                <i class="bi bi-check-circle me-2"></i>
                                Mettez en valeur les couleurs de vos produits
                            </div>
                            <div class="col-md-6 mb-3">
                                <i class="bi bi-check-circle me-2"></i>
                                Partagez vos astuces de jardinage
                            </div>
                            <div class="col-md-6 mb-3">
                                <i class="bi bi-check-circle me-2"></i>
                                Soyez authentique et créatif
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .upload-zone {
        transition: all var(--transition-fast);
    }
    
    .upload-zone:hover {
        border-color: var(--color-primary) !important;
        background-color: var(--color-light) !important;
    }
    
    .image-preview-item {
        position: relative;
        border-radius: 12px;
        overflow: hidden;
    }
    
    .image-preview-item img {
        width: 100%;
        height: 200px;
        object-fit: cover;
    }
    
    .image-preview-remove {
        position: absolute;
        top: 10px;
        right: 10px;
        background: rgba(0, 0, 0, 0.7);
        color: white;
        border: none;
        border-radius: 50%;
        width: 30px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all var(--transition-fast);
    }
    
    .image-preview-remove:hover {
        background: var(--color-secondary);
        transform: scale(1.1);
    }
</style>

<script>
    // Compteur de caractères
    const description = document.getElementById('description');
    const charCount = document.getElementById('charCount');
    
    description.addEventListener('input', function() {
        charCount.textContent = this.value.length + ' caractères';
    });
    
    // Prévisualisation des images
    const imagesInput = document.getElementById('images');
    const imagePreview = document.getElementById('imagePreview');
    
    imagesInput.addEventListener('change', function(e) {
        imagePreview.innerHTML = '';
        const files = Array.from(e.target.files);
        
        files.forEach((file, index) => {
            const reader = new FileReader();
            
            reader.onload = function(e) {
                const col = document.createElement('div');
                col.className = 'col-md-6 col-lg-4';
                
                col.innerHTML = `
                    <div class="image-preview-item">
                        <img src="${e.target.result}" alt="Preview">
                        <button type="button" class="image-preview-remove" onclick="removeImage(${index})">
                            <i class="bi bi-x"></i>
                        </button>
                    </div>
                `;
                
                imagePreview.appendChild(col);
            };
            
            reader.readAsDataURL(file);
        });
    });
    
    // Drag and drop
    const uploadZone = document.querySelector('.upload-zone');
    
    ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
        uploadZone.addEventListener(eventName, preventDefaults, false);
    });
    
    function preventDefaults(e) {
        e.preventDefault();
        e.stopPropagation();
    }
    
    ['dragenter', 'dragover'].forEach(eventName => {
        uploadZone.addEventListener(eventName, () => {
            uploadZone.style.borderColor = 'var(--color-primary)';
            uploadZone.style.backgroundColor = 'var(--color-light)';
        });
    });
    
    ['dragleave', 'drop'].forEach(eventName => {
        uploadZone.addEventListener(eventName, () => {
            uploadZone.style.borderColor = 'var(--color-grey-light)';
            uploadZone.style.backgroundColor = 'var(--color-white)';
        });
    });
    
    uploadZone.addEventListener('drop', function(e) {
        const dt = e.dataTransfer;
        const files = dt.files;
        imagesInput.files = files;
        
        // Trigger change event
        const event = new Event('change');
        imagesInput.dispatchEvent(event);
    });
    
    // Fonction pour supprimer une image (à implémenter complètement)
    function removeImage(index) {
        console.log('Remove image at index:', index);
        // TODO: Implémenter la suppression d'image
    }
</script>
{% endblock %}
