{% extends 'base.html.twig' %}

{% block title %}{{ publication.description|slice(0, 50) }} - Instagrume{% endblock %}

{% block body %}
<section class="py-5">
    <div class="container">
        <div class="row">
            {# Colonne principale - Publication #}
            <div class="col-lg-8 mb-4">
                <div class="card shadow-lg border-0 animate-on-scroll" style="border-radius: 20px;">
                    {# Images carousel si plusieurs images #}
                    {% if publication.images|length > 1 %}
                        <div id="publicationCarousel" class="carousel slide" data-bs-ride="carousel">
                            <div class="carousel-indicators">
                                {% for image in publication.images %}
                                    <button type="button" 
                                            data-bs-target="#publicationCarousel" 
                                            data-bs-slide-to="{{ loop.index0 }}" 
                                            class="{{ loop.first ? 'active' : '' }}">
                                    </button>
                                {% endfor %}
                            </div>
                            <div class="carousel-inner" style="border-radius: 20px 20px 0 0;">
                                {% for image in publication.images %}
                                    <div class="carousel-item {{ loop.first ? 'active' : '' }}">
                                        <img src="{{ image.url }}" 
                                             class="d-block w-100" 
                                             alt="{{ image.description }}"
                                             style="max-height: 600px; object-fit: cover;">
                                    </div>
                                {% endfor %}
                            </div>
                            <button class="carousel-control-prev" type="button" data-bs-target="#publicationCarousel" data-bs-slide="prev">
                                <span class="carousel-control-prev-icon"></span>
                            </button>
                            <button class="carousel-control-next" type="button" data-bs-target="#publicationCarousel" data-bs-slide="next">
                                <span class="carousel-control-next-icon"></span>
                            </button>
                        </div>
                    {% elseif publication.images|length == 1 %}
                        <img src="{{ 'http://127.0.0.1:3000' ~ publication.images[0].url }}" 
                             class="card-img-top" 
                             alt="{{ publication.description }}"
                             style="max-height: 600px; object-fit: cover; border-radius: 20px 20px 0 0;">
                    {% endif %}

                    <div class="card-body p-4">
                        {# User info #}
                        <div class="d-flex align-items-center mb-4">
                            {% if publication.user.images is defined and publication.user.images is not empty %}
                                <img src="{{ 'http://127.0.0.1:3000' ~ publication.user.images[0].url }}" 
                                     alt="{{ publication.user.username }}"
                                     class="avatar-lg me-3">
                            {% else %}
                                <div class="avatar-lg me-3 bg-primary-custom d-flex align-items-center justify-content-center text-white fw-bold">
                                    {{ publication.user.username|slice(0, 1)|upper }}
                                </div>
                            {% endif %}
                            <div class="flex-grow-1">
                                <h5 class="mb-0 fw-bold">{{ publication.user.username }}</h5>
                                <small class="text-muted">
                                    <i class="bi bi-clock"></i>
                                    Publié le {{ publication.created_at|date('d/m/Y à H:i') }}
                                </small>
                            </div>
                        </div>

                        {# Description #}
                        <p class="lead mb-4">
                            {{ publication.description }}
                        </p>

                        {# Actions - Likes / Dislikes #}
                        <div class="d-flex gap-3 mb-4 pb-4 border-bottom">
                            <button class="btn btn-outline-primary d-flex align-items-center gap-2">
                                <i class="bi bi-heart"></i>
                                <span>{{ publication.likes|length }}</span>
                            </button>
                            <button class="btn btn-outline-secondary d-flex align-items-center gap-2">
                                <i class="bi bi-heart-break"></i>
                                <span>{{ publication.dislikes|length }}</span>
                            </button>
                        </div>

                        {# Commentaires #}
                        <div class="mb-4">
                            <h4 class="mb-3">
                                <i class="bi bi-chat-dots"></i>
                                Commentaires ({{ publication.comments|length }})
                            </h4>

                            {% if app.session.get('api_token') %}
                                {# Formulaire d'ajout de commentaire #}
                                <form class="mb-4">
                                    <div class="mb-3">
                                        <textarea 
                                            class="form-control" 
                                            rows="3" 
                                            placeholder="Ajouter un commentaire..."
                                            style="border-radius: 12px;"></textarea>
                                    </div>
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bi bi-send"></i> Commenter
                                    </button>
                                </form>
                            {% else %}
                                <div class="alert alert-info">
                                    <i class="bi bi-info-circle"></i>
                                    <a href="{{ path('app_login') }}">Connectez-vous</a> pour commenter cette publication.
                                </div>
                            {% endif %}

                            {# Liste des commentaires #}
                            {% if publication.comments is not empty %}
                                <div class="comments-list">
                                    {% for comment in publication.comments %}
                                        {% if comment.original_comment is null %}
                                            <div class="comment-item mb-3 p-3 bg-light-custom" style="border-radius: 12px;">
                                                <div class="d-flex align-items-start">
                                                    {% if comment.user.images is defined and comment.user.images is not empty %}
                                                        <img src="{{ comment.user.images[0].url }}" 
                                                             alt="{{ comment.user.username }}"
                                                             class="avatar me-3">
                                                    {% else %}
                                                        <div class="avatar me-3 bg-secondary text-white d-flex align-items-center justify-content-center">
                                                            {{ comment.user.username|slice(0, 1)|upper }}
                                                        </div>
                                                    {% endif %}
                                                    <div class="flex-grow-1">
                                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                                            <div>
                                                                <strong>{{ comment.user.username }}</strong>
                                                                <small class="text-muted ms-2">
                                                                    {{ comment.created_at|date('d/m/Y à H:i') }}
                                                                </small>
                                                            </div>
                                                            <div class="text-muted">
                                                                <i class="bi bi-heart"></i> {{ comment.likes|length }}
                                                            </div>
                                                        </div>
                                                        <p class="mb-0">{{ comment.content }}</p>
                                                        
                                                        {# Réponses #}
                                                        {% if comment.comments is not empty %}
                                                            <div class="mt-3 ps-4 border-start border-3 border-primary">
                                                                {% for reply in comment.comments %}
                                                                    <div class="mb-2">
                                                                        <strong>{{ reply.user.username }}</strong>
                                                                        <small class="text-muted ms-2">
                                                                            {{ reply.created_at|date('d/m/Y') }}
                                                                        </small>
                                                                        <p class="mb-0">{{ reply.content }}</p>
                                                                    </div>
                                                                {% endfor %}
                                                            </div>
                                                        {% endif %}
                                                    </div>
                                                </div>
                                            </div>
                                        {% endif %}
                                    {% endfor %}
                                </div>
                            {% else %}
                                <p class="text-muted text-center py-4">
                                    <i class="bi bi-chat"></i>
                                    Aucun commentaire pour le moment. Soyez le premier à commenter !
                                </p>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>

            {# Colonne latérale - Autres publications #}
            <div class="col-lg-4">
                <div class="sticky-top" style="top: 100px;">
                    <h5 class="mb-3">Plus de {{ publication.user.username }}</h5>
                    <div class="d-flex flex-column gap-3">
                        {% for userPub in publication.user.publications|slice(0, 3) %}
                            {% if userPub.id != publication.id %}
                                <a href="{{ path('app_publication_show', {id: userPub.id}) }}" 
                                   class="card border-0 shadow-sm text-decoration-none">
                                    <div class="row g-0">
                                        <div class="col-4">
                                            {% if userPub.images is not empty %}
                                                <img src="{{ userPub.images[0].url }}" 
                                                     class="img-fluid rounded-start"
                                                     style="height: 100px; object-fit: cover;">
                                            {% endif %}
                                        </div>
                                        <div class="col-8">
                                            <div class="card-body">
                                                <p class="card-text small text-dark mb-1">
                                                    {{ userPub.description|slice(0, 60) }}{{ userPub.description|length > 60 ? '...' : '' }}
                                                </p>
                                                <small class="text-muted">
                                                    <i class="bi bi-heart"></i> {{ userPub.likes|length }}
                                                </small>
                                            </div>
                                        </div>
                                    </div>
                                </a>
                            {% endif %}
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>

        {# Bouton retour #}
        <div class="mt-4">
            <a href="{{ path('app_home') }}" class="btn btn-outline-primary">
                <i class="bi bi-arrow-left"></i> Retour à l'accueil
            </a>
        </div>
    </div>
</section>
{% endblock %}
