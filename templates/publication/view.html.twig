{% extends 'base.html.twig' %}

{% block title %}Publication - Instagrume{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-lg">
            {# Images #}
            {% if publication.images is not empty %}
                {% if publication.images|length == 1 %}
                    <img src="https://127.0.0.1:3000{{ publication.images[0].url }}" 
                         class="card-img-top" 
                         alt="{{ publication.description }}"
                         style="max-height: 500px; object-fit: contain; background: #f8f9fa;">
                {% else %}
                    <div id="carousel-detail" class="carousel slide" data-bs-ride="false">
                        <div class="carousel-inner">
                            {% for image in publication.images %}
                                <div class="carousel-item {% if loop.first %}active{% endif %}">
                                    <img src="https://127.0.0.1:3000{{ image.url }}" 
                                         class="d-block w-100" 
                                         alt="{{ publication.description }}"
                                         style="max-height: 500px; object-fit: contain; background: #f8f9fa;">
                                </div>
                            {% endfor %}
                        </div>
                        <button class="carousel-control-prev" type="button" data-bs-target="#carousel-detail" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#carousel-detail" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        </button>
                        <div class="carousel-indicators">
                            {% for image in publication.images %}
                                <button type="button" data-bs-target="#carousel-detail" 
                                        data-bs-slide-to="{{ loop.index0 }}" 
                                        {% if loop.first %}class="active"{% endif %}></button>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}
            {% endif %}

            <div class="card-body">
                {# En-tête #}
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-person-circle text-success fs-3 me-2"></i>
                        <div>
                            <h5 class="mb-0">
                                <a href="{{ path('app_user_profile', {username: publication.user.username}) }}" 
                                   class="text-decoration-none text-dark">
                                    {{ publication.user.username }}
                                </a>
                            </h5>
                            <small class="text-muted">{{ publication.created_at|date('d/m/Y à H:i') }}</small>
                        </div>
                    </div>
                </div>

                {# Description #}
                <p class="card-text">{{ publication.description }}</p>

                {# Likes et Dislikes #}
                <div class="d-flex gap-3 mb-3">
                    {% if app.session.get('token') %}
                        {% set userLiked = false %}
                        {% set userDisliked = false %}
                        {% set userLikeId = null %}
                        {% set userDislikeId = null %}

                        {% for like in publication.likes %}
                            {% if like.user.id == currentUser.id %}
                                {% set userLiked = true %}
                                {% set userLikeId = like.id %}
                            {% endif %}
                        {% endfor %}

                        {% for dislike in publication.dislikes %}
                            {% if dislike.user.id == currentUser.id %}
                                {% set userDisliked = true %}
                                {% set userDislikeId = dislike.id %}
                            {% endif %}
                        {% endfor %}

                        {# ✅ CORRECTION : Masquer les boutons si c'est SA publication #}
                        {% if currentUser.id != publication.user.id %}
                            {# Bouton Like #}
                            <form method="post" action="{% if userLiked %}{{ path('app_like_delete', {id: userLikeId}) }}{% else %}{{ path('app_publication_like', {id: publication.id}) }}{% endif %}" class="d-inline">
                                <button type="submit" class="btn btn-sm {% if userLiked %}btn-danger{% else %}btn-outline-danger{% endif %}">
                                    <i class="bi bi-heart{% if userLiked %}-fill{% endif %}"></i> {{ publication.likes|length }}
                                </button>
                            </form>

                            {# Bouton Dislike #}
                            <form method="post" action="{% if userDisliked %}{{ path('app_dislike_delete', {id: userDislikeId}) }}{% else %}{{ path('app_publication_dislike', {id: publication.id}) }}{% endif %}" class="d-inline">
                                <button type="submit" class="btn btn-sm {% if userDisliked %}btn-primary{% else %}btn-outline-primary{% endif %}">
                                    <i class="bi bi-hand-thumbs-down{% if userDisliked %}-fill{% endif %}"></i> {{ publication.dislikes|length }}
                                </button>
                            </form>
                        {% else %}
                            {# C'est sa propre publication, afficher seulement les compteurs #}
                            <span class="text-muted">
                                <i class="bi bi-heart"></i> {{ publication.likes|length }}
                                <i class="bi bi-hand-thumbs-down ms-3"></i> {{ publication.dislikes|length }}
                            </span>
                        {% endif %}
                    {% else %}
                        <span class="text-muted">
                            <i class="bi bi-heart"></i> {{ publication.likes|length }}
                            <i class="bi bi-hand-thumbs-down ms-3"></i> {{ publication.dislikes|length }}
                        </span>
                    {% endif %}
                </div>

                {# Boutons de modération pour les publications #}
                {% if app.session.get('user') and (('ROLE_MOD' in app.session.get('user').roles) or ('ROLE_ADMIN' in app.session.get('user').roles)) %}
                    <div class="mb-3">
                        {% if publication.is_locked %}
                            <form method="post" action="{{ path('app_publication_unlock', {id: publication.id}) }}" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-success">
                                    <i class="bi bi-unlock"></i> Déverrouiller les commentaires
                                </button>
                            </form>
                        {% else %}
                            <form method="post" action="{{ path('app_publication_lock', {id: publication.id}) }}" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-warning">
                                    <i class="bi bi-lock"></i> Verrouiller les commentaires
                                </button>
                            </form>
                        {% endif %}
                    </div>
                {% endif %}

                <hr>

                {# Commentaires #}
                <h5 class="mb-3">Commentaires ({{ publication.comments|length }})</h5>

                {# Formulaire d'ajout de commentaire #}
                {% if app.session.get('token') and not publication.is_locked %}
                    <form method="post" action="{{ path('app_publication_comment', {id: publication.id}) }}" class="mb-4">
                        <div class="input-group">
                            <input type="text" name="content" class="form-control" 
                                   placeholder="Ajouter un commentaire..." required>
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-send"></i>
                            </button>
                        </div>
                    </form>
                {% elseif publication.is_locked %}
                    <div class="alert alert-warning">
                        <i class="bi bi-lock"></i> Cette publication est verrouillée, vous ne pouvez plus commenter.
                    </div>
                {% endif %}

                {# Liste des commentaires #}
                {% if publication.comments is not empty %}
                    <div class="list-group">
                        {% for comment in publication.comments %}
                            {% if comment.original_comment is null %}
                                <div class="list-group-item" id="comment-{{ comment.id }}">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div class="flex-grow-1">
                                            <strong>{{ comment.user.username }}</strong>
                                            <p class="mb-1" id="comment-text-{{ comment.id }}">{{ comment.content }}</p>
                                            <small class="text-muted">{{ comment.created_at|date('d/m/Y à H:i') }}</small>
                                            
                                            {# Actions sur le commentaire #}
                                            {% if app.session.get('token') %}
                                                {# Like/Dislike du commentaire #}
                                                {% set commentUserLiked = false %}
                                                {% set commentUserDisliked = false %}
                                                {% set commentUserLikeId = null %}
                                                {% set commentUserDislikeId = null %}

                                                {% for like in comment.likes %}
                                                    {% if like.user.id == currentUser.id %}
                                                        {% set commentUserLiked = true %}
                                                        {% set commentUserLikeId = like.id %}
                                                    {% endif %}
                                                {% endfor %}

                                                {% for dislike in comment.dislikes %}
                                                    {% if dislike.user.id == currentUser.id %}
                                                        {% set commentUserDisliked = true %}
                                                        {% set commentUserDislikeId = dislike.id %}
                                                    {% endif %}
                                                {% endfor %}

                                                {# ✅ CORRECTION : Masquer les boutons si c'est SON commentaire #}
                                                {% if currentUser.id != comment.user.id %}
                                                    <div class="d-inline-block ms-2">
                                                        {# Bouton Like commentaire #}
                                                        <form method="post" action="{% if commentUserLiked %}{{ path('app_comment_like_delete', {id: commentUserLikeId}) }}{% else %}{{ path('app_comment_like', {id: comment.id}) }}{% endif %}" class="d-inline">
                                                            <button type="submit" class="btn btn-link btn-sm p-0 {% if commentUserLiked %}text-danger{% else %}text-muted{% endif %}">
                                                                <i class="bi bi-heart{% if commentUserLiked %}-fill{% endif %}"></i> {{ comment.likes|length }}
                                                            </button>
                                                        </form>

                                                        {# Bouton Dislike commentaire #}
                                                        <form method="post" action="{% if commentUserDisliked %}{{ path('app_comment_dislike_delete', {id: commentUserDislikeId}) }}{% else %}{{ path('app_comment_dislike', {id: comment.id}) }}{% endif %}" class="d-inline ms-2">
                                                            <button type="submit" class="btn btn-link btn-sm p-0 {% if commentUserDisliked %}text-primary{% else %}text-muted{% endif %}">
                                                                <i class="bi bi-hand-thumbs-down{% if commentUserDisliked %}-fill{% endif %}"></i> {{ comment.dislikes|length }}
                                                            </button>
                                                        </form>
                                                    </div>
                                                {% else %}
                                                    {# C'est son propre commentaire, afficher seulement les compteurs #}
                                                    <small class="text-muted ms-2">
                                                        <i class="bi bi-heart"></i> {{ comment.likes|length }}
                                                        <i class="bi bi-hand-thumbs-down ms-2"></i> {{ comment.dislikes|length }}
                                                    </small>
                                                {% endif %}

                                                {# Répondre #}
                                                {% if not publication.is_locked %}
                                                    <button class="btn btn-link btn-sm p-0 ms-2" 
                                                            onclick="document.getElementById('reply-form-{{ comment.id }}').style.display='block'">
                                                        Répondre
                                                    </button>
                                                {% endif %}
                                                
                                                {# Boutons éditer/supprimer si c'est son commentaire #}
                                                {% if app.session.get('user').username == comment.user.username %}
                                                    <button class="btn btn-link btn-sm p-0 ms-2" 
                                                            onclick="showEditForm({{ comment.id }}, '{{ comment.content|e('js') }}')">
                                                        <i class="bi bi-pencil"></i> Modifier
                                                    </button>
                                                    <form method="post" action="{{ path('app_comment_delete', {id: comment.id}) }}" class="d-inline">
                                                        <button type="submit" class="btn btn-link btn-sm p-0 ms-2 text-danger"
                                                                onclick="return confirm('Supprimer ce commentaire ?')">
                                                            <i class="bi bi-trash"></i> Supprimer
                                                        </button>
                                                    </form>
                                                {% elseif ('ROLE_MOD' in app.session.get('user').roles or 'ROLE_ADMIN' in app.session.get('user').roles) %}
                                                    {# Modérateur peut supprimer sauf les commentaires des admins/mods #}
                                                    {% if 'ROLE_ADMIN' not in comment.user.roles and 'ROLE_MOD' not in comment.user.roles %}
                                                        <form method="post" action="{{ path('app_comment_delete', {id: comment.id}) }}" class="d-inline">
                                                            <button type="submit" class="btn btn-link btn-sm p-0 ms-2 text-danger"
                                                                    onclick="return confirm('Supprimer ce commentaire ?')">
                                                                <i class="bi bi-trash"></i> Supprimer
                                                            </button>
                                                        </form>
                                                    {% endif %}
                                                {% endif %}
                                            {% else %}
                                                {# Affichage pour les non connectés #}
                                                <small class="text-muted ms-2">
                                                    <i class="bi bi-heart"></i> {{ comment.likes|length }}
                                                    <i class="bi bi-hand-thumbs-down ms-2"></i> {{ comment.dislikes|length }}
                                                </small>
                                            {% endif %}
                                        </div>
                                    </div>

                                    {# Formulaire d'édition caché #}
                                    <form method="post" action="{{ path('app_comment_edit', {id: comment.id}) }}" 
                                          id="edit-form-{{ comment.id }}" class="mt-2" style="display:none;">
                                        <div class="input-group input-group-sm">
                                            <input type="text" name="content" class="form-control" 
                                                   id="edit-input-{{ comment.id }}" required>
                                            <button type="submit" class="btn btn-success">
                                                <i class="bi bi-check"></i>
                                            </button>
                                            <button type="button" class="btn btn-secondary" 
                                                    onclick="hideEditForm({{ comment.id }})">
                                                <i class="bi bi-x"></i>
                                            </button>
                                        </div>
                                    </form>

                                    {# Formulaire de réponse caché #}
                                    {% if app.session.get('token') and not publication.is_locked %}
                                        <form method="post" action="{{ path('app_publication_comment', {id: publication.id}) }}" 
                                              id="reply-form-{{ comment.id }}" class="mt-2" style="display:none;">
                                            <input type="hidden" name="original_comment_id" value="{{ comment.id }}">
                                            <div class="input-group input-group-sm">
                                                <input type="text" name="content" class="form-control" 
                                                       placeholder="Répondre à {{ comment.user.username }}..." required>
                                                <button type="submit" class="btn btn-success">
                                                    <i class="bi bi-send"></i>
                                                </button>
                                                <button type="button" class="btn btn-secondary" 
                                                        onclick="document.getElementById('reply-form-{{ comment.id }}').style.display='none'">
                                                    Annuler
                                                </button>
                                            </div>
                                        </form>
                                    {% endif %}

                                    {# Réponses au commentaire #}
                                    {% if comment.comments is not empty %}
                                        <div class="ms-4 mt-2">
                                            {% for reply in comment.comments %}
                                                <div class="border-start border-3 border-secondary ps-3 mb-2" id="comment-{{ reply.id }}">
                                                    <strong>{{ reply.user.username }}</strong>
                                                    <p class="mb-1 small" id="comment-text-{{ reply.id }}">{{ reply.content }}</p>
                                                    <small class="text-muted">{{ reply.created_at|date('d/m/Y à H:i') }}</small>
                                                    
                                                    {# Actions sur la réponse #}
                                                    {% if app.session.get('token') %}
                                                        {# Like/Dislike de la réponse #}
                                                        {% set replyUserLiked = false %}
                                                        {% set replyUserDisliked = false %}
                                                        {% set replyUserLikeId = null %}
                                                        {% set replyUserDislikeId = null %}

                                                        {% for like in reply.likes %}
                                                            {% if like.user.id == currentUser.id %}
                                                                {% set replyUserLiked = true %}
                                                                {% set replyUserLikeId = like.id %}
                                                            {% endif %}
                                                        {% endfor %}

                                                        {% for dislike in reply.dislikes %}
                                                            {% if dislike.user.id == currentUser.id %}
                                                                {% set replyUserDisliked = true %}
                                                                {% set replyUserDislikeId = dislike.id %}
                                                            {% endif %}
                                                        {% endfor %}

                                                        {# ✅ CORRECTION : Masquer les boutons si c'est SA réponse #}
                                                        {% if currentUser.id != reply.user.id %}
                                                            <div class="d-inline-block ms-2">
                                                                {# Bouton Like réponse #}
                                                                <form method="post" action="{% if replyUserLiked %}{{ path('app_comment_like_delete', {id: replyUserLikeId}) }}{% else %}{{ path('app_comment_like', {id: reply.id}) }}{% endif %}" class="d-inline">
                                                                    <button type="submit" class="btn btn-link btn-sm p-0 {% if replyUserLiked %}text-danger{% else %}text-muted{% endif %}">
                                                                        <i class="bi bi-heart{% if replyUserLiked %}-fill{% endif %}"></i> {{ reply.likes|length }}
                                                                    </button>
                                                                </form>

                                                                {# Bouton Dislike réponse #}
                                                                <form method="post" action="{% if replyUserDisliked %}{{ path('app_comment_dislike_delete', {id: replyUserDislikeId}) }}{% else %}{{ path('app_comment_dislike', {id: reply.id}) }}{% endif %}" class="d-inline ms-2">
                                                                    <button type="submit" class="btn btn-link btn-sm p-0 {% if replyUserDisliked %}text-primary{% else %}text-muted{% endif %}">
                                                                        <i class="bi bi-hand-thumbs-down{% if replyUserDisliked %}-fill{% endif %}"></i> {{ reply.dislikes|length }}
                                                                    </button>
                                                                </form>
                                                            </div>
                                                        {% else %}
                                                            {# C'est sa propre réponse, afficher seulement les compteurs #}
                                                            <small class="text-muted ms-2">
                                                                <i class="bi bi-heart"></i> {{ reply.likes|length }}
                                                                <i class="bi bi-hand-thumbs-down ms-2"></i> {{ reply.dislikes|length }}
                                                            </small>
                                                        {% endif %}

                                                        {# Éditer/Supprimer #}
                                                        {% if app.session.get('user').username == reply.user.username %}
                                                            <button class="btn btn-link btn-sm p-0 ms-2" 
                                                                    onclick="showEditForm({{ reply.id }}, '{{ reply.content|e('js') }}')">
                                                                <i class="bi bi-pencil"></i> Modifier
                                                            </button>
                                                            <form method="post" action="{{ path('app_comment_delete', {id: reply.id}) }}" class="d-inline">
                                                                <button type="submit" class="btn btn-link btn-sm p-0 ms-2 text-danger"
                                                                        onclick="return confirm('Supprimer cette réponse ?')">
                                                                    <i class="bi bi-trash"></i> Supprimer
                                                                </button>
                                                            </form>
                                                        {% elseif ('ROLE_MOD' in app.session.get('user').roles or 'ROLE_ADMIN' in app.session.get('user').roles) %}
                                                            {% if 'ROLE_ADMIN' not in reply.user.roles and 'ROLE_MOD' not in reply.user.roles %}
                                                                <form method="post" action="{{ path('app_comment_delete', {id: reply.id}) }}" class="d-inline">
                                                                    <button type="submit" class="btn btn-link btn-sm p-0 ms-2 text-danger"
                                                                            onclick="return confirm('Supprimer cette réponse ?')">
                                                                        <i class="bi bi-trash"></i> Supprimer
                                                                    </button>
                                                                </form>
                                                            {% endif %}
                                                        {% endif %}
                                                    {% else %}
                                                        {# Affichage pour les non connectés #}
                                                        <small class="text-muted ms-2">
                                                            <i class="bi bi-heart"></i> {{ reply.likes|length }}
                                                            <i class="bi bi-hand-thumbs-down ms-2"></i> {{ reply.dislikes|length }}
                                                        </small>
                                                    {% endif %}

                                                    {# Formulaire d'édition pour la réponse #}
                                                    <form method="post" action="{{ path('app_comment_edit', {id: reply.id}) }}" 
                                                          id="edit-form-{{ reply.id }}" class="mt-2" style="display:none;">
                                                        <div class="input-group input-group-sm">
                                                            <input type="text" name="content" class="form-control" 
                                                                   id="edit-input-{{ reply.id }}" required>
                                                            <button type="submit" class="btn btn-success">
                                                                <i class="bi bi-check"></i>
                                                            </button>
                                                            <button type="button" class="btn btn-secondary" 
                                                                    onclick="hideEditForm({{ reply.id }})">
                                                                <i class="bi bi-x"></i>
                                                            </button>
                                                        </div>
                                                    </form>
                                                </div>
                                            {% endfor %}
                                        </div>
                                    {% endif %}
                                </div>
                            {% endif %}
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="text-muted text-center">Aucun commentaire pour le moment.</p>
                {% endif %}
            </div>
        </div>

        <div class="text-center mt-3">
            <a href="{{ path('app_home') }}" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Retour à l'accueil
            </a>
        </div>
    </div>
</div>

{# JavaScript pour l'édition des commentaires #}
<script>
function showEditForm(commentId, currentContent) {
    // Masquer le texte du commentaire
    document.getElementById('comment-text-' + commentId).style.display = 'none';
    
    // Afficher le formulaire d'édition
    const form = document.getElementById('edit-form-' + commentId);
    form.style.display = 'block';
    
    // Pré-remplir l'input avec le contenu actuel
    document.getElementById('edit-input-' + commentId).value = currentContent;
}

function hideEditForm(commentId) {
    // Afficher le texte du commentaire
    document.getElementById('comment-text-' + commentId).style.display = 'block';
    
    // Masquer le formulaire d'édition
    document.getElementById('edit-form-' + commentId).style.display = 'none';
}
</script>
{% endblock %}