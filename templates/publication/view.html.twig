{% extends 'base.html.twig' %}

{% block title %}Publication - Instagrume{% endblock %}

{% block javascripts %}
    {# Rendre le token disponible pour JavaScript #}
    {% if app.session.get('token') %}
        <script>
            window.API_TOKEN = '{{ app.session.get('token') }}';
        </script>
    {% endif %}
    <script src="{{ asset('js/viewPubli.js') }}"></script>
{% endblock %}

{% block body %}
<div style="max-width: 900px; margin: 0 auto;">
    <div class="card">
        {# Images avec carousel #}
        {% if publication.images is not empty %}
            {% if publication.images|length == 1 %}
                <img 
                    src="https://127.0.0.1:3000{{ publication.images[0].url }}" 
                    alt="{{ publication.description }}"
                    style="width: 100%; height: 500px; object-fit: contain; background: var(--amber-1); border-radius: var(--radius-lg) var(--radius-lg) 0 0;"
                >
            {% else %}
                <div class="carousel" id="publicationCarousel">
                    <div class="carousel-inner">
                        {% for image in publication.images %}
                            <div class="carousel-item {% if loop.first %}active{% endif %}">
                                <img 
                                    src="https://127.0.0.1:3000{{ image.url }}" 
                                    alt="{{ publication.description }}"
                                >
                            </div>
                        {% endfor %}
                    </div>
                    <button class="carousel-control carousel-control-prev" onclick="moveCarousel(-1)">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                    <button class="carousel-control carousel-control-next" onclick="moveCarousel(1)">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                    
                    {# Compteur d'images #}
                    <div style="position: absolute; top: var(--spacing-md); right: var(--spacing-md); background: rgba(0,0,0,0.7); color: white; padding: var(--spacing-xs) var(--spacing-sm); border-radius: var(--radius-sm); font-size: var(--font-size-sm); font-weight: 600;">
                        <span id="current-slide">1</span> / {{ publication.images|length }}
                    </div>
                </div>
            {% endif %}
        {% endif %}
        
        <div class="card-body">
            {# En-tête avec auteur #}
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--spacing-lg); padding-bottom: var(--spacing-lg); border-bottom: 1px solid var(--color-border-light);">
                <div style="display: flex; align-items: center; gap: var(--spacing-md);">
                    {% if publication.user.images is defined and publication.user.images is not empty %}
                        <img 
                            src="https://127.0.0.1:3000{{ publication.user.images[0].url }}" 
                            alt="{{ publication.user.username }}"
                            style="width: 56px; height: 56px; border-radius: var(--radius-full); object-fit: cover; border: 3px solid var(--color-primary);"
                        >
                    {% else %}
                        <i class="bi bi-person-circle" style="font-size: 3.5rem; color: var(--color-primary);"></i>
                    {% endif %}
                    <div>
                        <a href="{{ path('app_user_profile', {username: publication.user.username}) }}" style="font-weight: 600; font-size: var(--font-size-lg); color: var(--color-text-primary);">
                            {{ publication.user.username }}
                        </a>
                        <p class="text-muted" style="margin: 0; font-size: var(--font-size-sm);">
                            {{ publication.created_at|date('d/m/Y à H:i') }}
                        </p>
                    </div>
                </div>
                
                {# Actions si c'est l'auteur #}
                {% if app.session.get('user') and app.session.get('user').username == publication.user.username %}
                    <div style="display: flex; gap: var(--spacing-sm);">
                        <a href="{{ path('app_publication_edit', {id: publication.id}) }}" class="btn btn-ghost btn-icon" title="Modifier">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form method="post" action="{{ path('app_publication_delete', {id: publication.id}) }}" style="display: inline;" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette publication ?');">
                            <button type="submit" class="btn btn-ghost btn-icon" title="Supprimer" style="color: var(--color-error);">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </div>
                {% endif %}
            </div>
            
            {# Description #}
            <div>
                <p style="font-size: var(--font-size-base); line-height: 1.6; color: var(--color-text-primary); white-space: pre-wrap;">{{ publication.description }}</p>
            </div>
            
            {# Actions auteur ou modérateur #}
            {% if app.session.get('user') %}
                <div style="display: flex; gap: var(--spacing-sm); margin-bottom: var(--spacing-lg);">
                    {# Si c'est un modérateur ou admin #}
                    {% if 'ROLE_MOD' in app.session.get('user').roles or 'ROLE_ADMIN' in app.session.get('user').roles %}
                        {# FIX : Comparer explicitement à 1, true ou "1" #}
                        {% if publication.is_locked == 1 or publication.is_locked == true or publication.is_locked == "1" %}
                            <form method="post" action="{{ path('app_publication_unlock', {id: publication.id}) }}" style="display: inline;">
                                <button type="submit" class="btn" style="background: var(--color-success); color: white;">
                                    <i class="bi bi-unlock"></i>
                                    <span>Déverrouiller les commentaires</span>
                                </button>
                            </form>
                        {% else %}
                            <form method="post" action="{{ path('app_publication_lock', {id: publication.id}) }}" style="display: inline;">
                                <button type="submit" class="btn" style="background: var(--color-warning); color: white;">
                                    <i class="bi bi-lock"></i>
                                    <span>Verrouiller les commentaires</span>
                                </button>
                            </form>
                        {% endif %}
                    {% endif %}
                </div>
            {% endif %}

            {# Actions (likes, dislikes) #}
            <div style="display: flex; align-items: center; gap: var(--spacing-xl); padding: var(--spacing-lg) 0; border-top: 1px solid var(--color-border-light); border-bottom: 1px solid var(--color-border-light);">
                {% if app.session.get('token') and app.session.get('user') and app.session.get('user').username != publication.user.username %}
                    {% set currentUserId = app.session.get('user').id %}
                    {% set userHasLiked = false %}
                    {% set userHasDisliked = false %}
                    
                    {# Vérifier si l'utilisateur a liké #}
                    {% for like in publication.likes %}
                        {% if like.user.id == currentUserId %}
                            {% set userHasLiked = true %}
                        {% endif %}
                    {% endfor %}
                    
                    {# Vérifier si l'utilisateur a disliké #}
                    {% for dislike in publication.dislikes %}
                        {% if dislike.user.id == currentUserId %}
                            {% set userHasDisliked = true %}
                        {% endif %}
                    {% endfor %}
                    
                    {# Bouton Like - cliquable #}
                    <button class="btn btn-ghost" onclick="toggleLike({{ publication.id }}, 'publication')" id="like-btn-pub-{{ publication.id }}" style="display: flex; align-items: center; gap: var(--spacing-sm); {% if userHasLiked %}color: var(--color-primary); font-weight: 600;{% endif %}">
                        <i class="bi bi-heart{% if userHasLiked %}-fill{% endif %}" id="like-icon-pub-{{ publication.id }}" style="font-size: 1.25rem;"></i>
                        <span style="font-weight: 600;" id="like-count-pub-{{ publication.id }}">{{ publication.likes|length }}</span>
                        <span style="font-size: var(--font-size-sm);">j'aime</span>
                    </button>
                    
                    {# Bouton Dislike - cliquable, sans compteur #}
                    <button class="btn btn-ghost" onclick="toggleDislike({{ publication.id }}, 'publication')" id="dislike-btn-pub-{{ publication.id }}" style="display: flex; align-items: center; gap: var(--spacing-sm); {% if userHasDisliked %}color: var(--color-primary); font-weight: 600;{% endif %}">
                        <i class="bi bi-heartbreak{% if userHasDisliked %}-fill{% endif %}" id="dislike-icon-pub-{{ publication.id }}" style="font-size: 1.25rem;"></i>
                        <span style="font-size: var(--font-size-sm);">Je n'aime pas</span>
                    </button>
                {% else %}
                    {# Affichage statique si non connecté ou auteur #}
                    <div style="display: flex; align-items: center; gap: var(--spacing-sm); color: var(--color-text-muted);">
                        <i class="bi bi-heart" style="font-size: 1.25rem;"></i>
                        <span style="font-weight: 600;">{{ publication.likes|length }}</span>
                        <span style="font-size: var(--font-size-sm);">j'aime</span>
                    </div>
                {% endif %}
                
                <div style="display: flex; align-items: center; gap: var(--spacing-sm); color: var(--color-text-muted);">
                    <i class="bi bi-chat" style="font-size: 1.25rem;"></i>
                    <span style="font-weight: 600;">{{ publication.comments|length }}</span>
                    <span style="font-size: var(--font-size-sm);">commentaires</span>
                </div>
            </div>
            
            {# Section commentaires #}
            <div style="margin-top: var(--spacing-xl);">
                <h3 style="font-size: var(--font-size-xl); margin-bottom: var(--spacing-lg);">Commentaires</h3>
                
                {# Message si publication verrouillée #}
                {% if publication.is_locked == 1 or publication.is_locked == true or publication.is_locked == "1" %}
                    <div class="alert alert-warning" style="margin-bottom: var(--spacing-lg);">
                        <i class="bi bi-lock-fill"></i>
                        <span>Cette publication est verrouillée. Les commentaires sont désactivés.</span>
                    </div>
                {% endif %}
                
                {# Formulaire pour ajouter un commentaire (si connecté ET pas verrouillé) #}
                {% set isLocked = publication.is_locked == 1 or publication.is_locked == true or publication.is_locked == "1" %}
                {% if app.session.get('token') and not isLocked %}
                    <div style="margin-bottom: var(--spacing-xl); padding: var(--spacing-lg); background: var(--color-background-alt); border-radius: var(--radius-md); border: 1px solid var(--color-border-light);">
                        <form id="comment-form" onsubmit="postComment(event, {{ publication.id }}, null)">
                            <div class="form-group" style="margin-bottom: var(--spacing-md);">
                                <textarea 
                                    class="form-textarea" 
                                    id="comment-input"
                                    rows="3" 
                                    placeholder="Écrire un commentaire..."
                                    required
                                ></textarea>
                            </div>
                            <div style="display: flex; justify-content: flex-end;">
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-send"></i>
                                    <span>Publier</span>
                                </button>
                            </div>
                        </form>
                    </div>
                {% endif %}
                
                {% if publication.comments is empty %}
                    <div class="text-center" style="padding: var(--spacing-xl); color: var(--color-text-muted);">
                        <i class="bi bi-chat-dots" style="font-size: 2rem; display: block; margin-bottom: var(--spacing-sm);"></i>
                        <p>Aucun commentaire pour le moment</p>
                        {% if not app.session.get('token') %}
                            <p style="font-size: var(--font-size-sm);">
                                <a href="{{ path('app_login') }}">Connectez-vous</a> pour commenter
                            </p>
                        {% endif %}
                    </div>
                {% else %}
                    <div id="comments-list" style="max-height: 600px; overflow-y: auto;">
                        {% for comment in publication.comments %}
                            {% if not comment.original_comment %}
                                {{ _self.render_comment(comment, app, publication.id, isLocked) }}
                            {% endif %}
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
    
    {# Bouton retour #}
    <div style="margin-top: var(--spacing-xl);">
        <a href="{{ path('app_home') }}" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i>
            <span>Retour aux publications</span>
        </a>
    </div>
</div>

{# Macro pour rendre un commentaire de manière récursive #}
{% macro render_comment(comment, app, publicationId, isLocked) %}
    <div class="comment-item" id="comment-{{ comment.id }}" style="margin-left: {{ comment.original_comment ? '2rem' : '0' }};">
        <div style="display: flex; gap: var(--spacing-md);">
            {% if comment.user.images is defined and comment.user.images is not empty %}
                <img 
                    src="https://127.0.0.1:3000{{ comment.user.images[0].url }}" 
                    alt="{{ comment.user.username }}"
                    style="width: 40px; height: 40px; border-radius: var(--radius-full); object-fit: cover; border: 2px solid var(--color-primary); flex-shrink: 0;"
                >
            {% else %}
                <i class="bi bi-person-circle" style="font-size: 2.5rem; color: var(--color-primary); flex-shrink: 0;"></i>
            {% endif %}
            <div style="flex: 1;">
                <div style="display: flex; align-items: center; gap: var(--spacing-sm); margin-bottom: var(--spacing-xs);">
                    <span style="font-weight: 600; color: var(--color-text-primary);">
                        {{ comment.user.username }}
                    </span>
                    <span class="text-muted" style="font-size: var(--font-size-xs);">
                        {{ comment.created_at|date('d/m/Y à H:i') }}
                    </span>
                </div>
                <p style="color: var(--color-text-primary); margin: 0 0 var(--spacing-sm) 0;">
                    {{ comment.content }}
                </p>
                
                {# Actions du commentaire #}
                <div style="display: flex; align-items: center; gap: var(--spacing-lg); font-size: var(--font-size-sm);">
                    {% if app.session.get('token') and app.session.get('user') and app.session.get('user').username != comment.user.username %}
                        {% set currentUserId = app.session.get('user').id %}
                        {% set userHasLikedComment = false %}
                        {% set userHasDislikedComment = false %}
                        
                        {# Vérifier si l'utilisateur a liké ce commentaire #}
                        {% for like in comment.likes %}
                            {% if like.user.id == currentUserId %}
                                {% set userHasLikedComment = true %}
                            {% endif %}
                        {% endfor %}
                        
                        {# Vérifier si l'utilisateur a disliké ce commentaire #}
                        {% for dislike in comment.dislikes %}
                            {% if dislike.user.id == currentUserId %}
                                {% set userHasDislikedComment = true %}
                            {% endif %}
                        {% endfor %}
                        
                        {# Like #}
                        <button class="btn btn-ghost btn-sm" onclick="toggleLike({{ comment.id }}, 'comment')" id="like-btn-com-{{ comment.id }}" style="padding: var(--spacing-xs) var(--spacing-sm); {% if userHasLikedComment %}color: var(--color-primary); font-weight: 600;{% endif %}">
                            <i class="bi bi-heart{% if userHasLikedComment %}-fill{% endif %}" id="like-icon-com-{{ comment.id }}"></i>
                            <span id="like-count-com-{{ comment.id }}">{{ comment.likes|length }}</span>
                        </button>
                        
                        {# Dislike #}
                        <button class="btn btn-ghost btn-sm" onclick="toggleDislike({{ comment.id }}, 'comment')" id="dislike-btn-com-{{ comment.id }}" style="padding: var(--spacing-xs) var(--spacing-sm); {% if userHasDislikedComment %}color: var(--color-primary); font-weight: 600;{% endif %}">
                            <i class="bi bi-heartbreak{% if userHasDislikedComment %}-fill{% endif %}" id="dislike-icon-com-{{ comment.id }}"></i>
                        </button>
                        
                        {# Répondre (seulement si pas verrouillé) #}
                        {% if not isLocked %}
                            <button class="btn btn-ghost btn-sm" onclick="showReplyForm({{ comment.id }}, '{{ comment.user.username }}')" style="padding: var(--spacing-xs) var(--spacing-sm);">
                                <i class="bi bi-reply"></i>
                                <span>Répondre</span>
                            </button>
                        {% endif %}
                    {% else %}
                        {# Affichage statique #}
                        <span style="color: var(--color-text-muted);">
                            <i class="bi bi-heart"></i> {{ comment.likes|length }}
                        </span>
                        {% if app.session.get('token') and not isLocked %}
                            <button class="btn btn-ghost btn-sm" onclick="showReplyForm({{ comment.id }}, '{{ comment.user.username }}')" style="padding: var(--spacing-xs) var(--spacing-sm);">
                                <i class="bi bi-reply"></i>
                                <span>Répondre</span>
                            </button>
                        {% endif %}
                    {% endif %}
                </div>
                
                {# Formulaire de réponse (caché par défaut) #}
                <div id="reply-form-{{ comment.id }}" style="display: none; margin-top: var(--spacing-md); padding: var(--spacing-md); background: var(--color-background-alt); border-radius: var(--radius-md); border: 1px solid var(--color-border-light);">
                    <form onsubmit="postComment(event, {{ publicationId }}, {{ comment.id }})">
                        <div class="form-group" style="margin-bottom: var(--spacing-sm);">
                            <textarea 
                                class="form-textarea" 
                                id="reply-input-{{ comment.id }}"
                                rows="2" 
                                placeholder="Répondre à {{ comment.user.username }}..."
                                required
                            ></textarea>
                        </div>
                        <div style="display: flex; justify-content: flex-end; gap: var(--spacing-sm);">
                            <button type="button" class="btn btn-ghost btn-sm" onclick="hideReplyForm({{ comment.id }})">
                                Annuler
                            </button>
                            <button type="submit" class="btn btn-primary btn-sm">
                                <i class="bi bi-send"></i>
                                <span>Répondre</span>
                            </button>
                        </div>
                    </form>
                </div>
                
                {# Réponses (commentaires enfants) #}
                {% if comment.comments is not empty %}
                    <div style="margin-top: var(--spacing-md);">
                        {% for reply in comment.comments %}
                            {{ _self.render_comment(reply, app, publicationId, isLocked) }}
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endmacro %}

{% endblock %}
