{% extends 'base.html.twig' %}

{% block title %}Accueil - Instagrume{% endblock %}

{% block stylesheets %}<link rel="stylesheet" href="{{ asset('styles/homeStyle.css') }}">{% endblock %}

{% block body %}
<div class="container py-4">
    {# Hero Section moderne #}
    <div class="hero-section animate-fade-in shadow-sm">
        <div class="row align-items-center">
            <div class="col-lg-8 mx-auto text-center position-relative">
                <h1 class="hero-title display-3 fw-bold mb-3">
                    Instagrume
                </h1>
                <p class="lead text-muted mb-4">
                    Partagez vos fruits et légumes favoris avec la communauté et inspirez une alimentation saine ! 🥗
                </p>
                {% if app.user is null %}
                    <div class="d-flex gap-3 justify-content-center">
                        <a href="{{ path('app_security_register') }}" class="btn btn-modern btn-primary-modern btn-lg" style="color: white;">
                            <i class="bi bi-person-plus me-2"></i> Rejoindre la communauté
                        </a>
                        <a href="{{ path('app_security_login') }}" class="btn btn-lg btn-outline-secondary" style="border-radius: 12px; font-weight: 600;">
                            <i class="bi bi-box-arrow-in-right me-2"></i> Se connecter
                        </a>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    {# Statistiques rapides (optionnel) #}
    <div class="row g-3 mb-5">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm" style="border-radius: 16px;">
                <div class="card-body text-center py-4">
                    <i class="bi bi-camera text-success" style="font-size: 2.5rem;"></i>
                    <h3 class="fw-bold mt-3 mb-1" style="color: var(--primary-green);">1,234</h3>
                    <p class="text-muted mb-0">Publications</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm" style="border-radius: 16px;">
                <div class="card-body text-center py-4">
                    <i class="bi bi-people text-success" style="font-size: 2.5rem;"></i>
                    <h3 class="fw-bold mt-3 mb-1" style="color: var(--primary-green);">567</h3>
                    <p class="text-muted mb-0">Membres</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm" style="border-radius: 16px;">
                <div class="card-body text-center py-4">
                    <i class="bi bi-heart-fill text-success" style="font-size: 2.5rem;"></i>
                    <h3 class="fw-bold mt-3 mb-1" style="color: var(--primary-green);">8.9K</h3>
                    <p class="text-muted mb-0">Likes</p>
                </div>
            </div>
        </div>
    </div>

    {# Titre de section #}
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="fw-bold mb-1">
                <i class="bi bi-grid-3x3-gap text-success me-2"></i>
                Découvrez les publications
            </h2>
            <p class="text-muted">Les dernières photos de fruits et légumes partagées par la communauté</p>
        </div>
    </div>

    {# Grid des publications modernes #}
    <div class="row g-4 mb-5">
        {# 
            TODO: Remplacer par les vraies données de l'API
            {% for publication in publications %}
        #}
        
        {# Publication 1 #}
        <div class="col-12 col-md-6 col-lg-4 animate-fade-in">
            <div class="publication-card card h-100">
                {# Image container #}
                <div style="height: 280px; overflow: hidden; position: relative;">
                    <img src="https://images.unsplash.com/photo-1610832958506-aa56368176cf?w=500&h=500&fit=crop" 
                         class="card-img-top w-100 h-100" 
                         alt="Fruits frais"
                         style="object-fit: cover;">
                </div>
                
                <div class="card-body p-4">
                    {# User info #}
                    <div class="d-flex align-items-center mb-3">
                        <img src="https://ui-avatars.com/api/?name=Marie+Dupont&background=10b981&color=fff" 
                             class="rounded-circle avatar-modern me-3" 
                             width="45" 
                             height="45"
                             alt="Avatar">
                        <div class="flex-grow-1">
                            <a href="{{ path('app_user_profile') }}" class="username-link d-block">
                                marie_dupont
                            </a>
                            <small class="timestamp">Il y a 2 heures</small>
                        </div>
                    </div>
                    
                    {# Description #}
                    <p class="publication-description mb-3">
                        Rien de meilleur pour commencer la journée 🍓✨
                    </p>
                    
                    {# Actions bar #}
                    <div class="d-flex gap-2 align-items-center">
                        <button class="btn action-btn action-btn-like flex-grow-1">
                            <i class="bi bi-hand-thumbs-up-fill"></i>
                            <span class="count-badge">24</span>
                        </button>
                        <button class="btn action-btn action-btn-dislike flex-grow-1">
                            <i class="bi bi-hand-thumbs-down-fill"></i>
                            <span class="count-badge">1</span>
                        </button>
                        <a href="{{ path('app_publication_show') }}" class="btn action-btn action-btn-comment flex-grow-1">
                            <i class="bi bi-chat-dots-fill"></i>
                            <span class="count-badge">5</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>

