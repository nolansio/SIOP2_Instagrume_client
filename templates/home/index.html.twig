{% extends 'base.html.twig' %}

{% block title %}Accueil - Instagrume{% endblock %}

{% block body %}
<div class="text-center mb-5">
    <h1 class="display-4 mb-3">
        <i class="bi bi-apple text-success"></i> Instagrume
    </h1>
    <p class="lead text-muted">Partagez vos fruits et légumes préférés !</p>
</div>

{% if publications is empty %}
    <div class="alert alert-info text-center">
        <i class="bi bi-info-circle"></i> Aucune publication pour le moment.
        {% if app.session.get('token') %}
            Soyez le premier à partager vos fruits et légumes !
        {% else %}
            Connectez-vous pour commencer à partager !
        {% endif %}
    </div>
{% else %}
    <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
        {% for publication in publications %}
            <div class="col">
                <a href="{{ path('app_publication_view', {id: publication.id}) }}" class="text-decoration-none">
                    <div class="card h-100 shadow-sm">
                        <div class="card h-100 shadow-sm">
                            {% if publication.images is not empty %}
                                {% if publication.images|length == 1 %}
                                    {# Une seule image : affichage simple #}
                                    <img src="https://127.0.0.1:3000{{ publication.images[0].url }}" 
                                        class="card-img-top" 
                                        alt="{{ publication.description }}"
                                        style="height: 250px; object-fit: cover;">
                                {% else %}
                                    {# Plusieurs images : carousel #}
                                    <div id="carousel-{{ publication.id }}" class="carousel slide" data-bs-ride="false">
                                        <div class="carousel-inner">
                                            {% for image in publication.images %}
                                                <div class="carousel-item {% if loop.first %}active{% endif %}">
                                                    <img src="https://127.0.0.1:3000{{ image.url }}" 
                                                        class="d-block w-100" 
                                                        alt="{{ publication.description }}"
                                                        style="height: 250px; object-fit: cover;">
                                                </div>
                                            {% endfor %}
                                        </div>
                                        <button class="carousel-control-prev" type="button" data-bs-target="#carousel-{{ publication.id }}" data-bs-slide="prev">
                                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                        </button>
                                        <button class="carousel-control-next" type="button" data-bs-target="#carousel-{{ publication.id }}" data-bs-slide="next">
                                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                        </button>
                                        <div class="carousel-indicators">
                                            {% for image in publication.images %}
                                                <button type="button" data-bs-target="#carousel-{{ publication.id }}" 
                                                        data-bs-slide-to="{{ loop.index0 }}" 
                                                        {% if loop.first %}class="active"{% endif %}></button>
                                            {% endfor %}
                                        </div>
                                    </div>
                                {% endif %}
                            {% else %}
                                <div class="bg-light d-flex align-items-center justify-content-center" 
                                    style="height: 250px;">
                                    <i class="bi bi-image text-muted" style="font-size: 3rem;"></i>
                                </div>
                            {% endif %}
                            
                            <div class="card-body">
                                <div class="d-flex align-items-center mb-2">
                                    <strong class="me-2">
                                        <a href="{{ path('app_user_profile', {username: publication.user.username}) }}" 
                                        class="text-decoration-none text-dark">
                                            <i class="bi bi-person-circle"></i> {{ publication.user.username }}
                                        </a>
                                    </strong>
                                </div>
                                <p class="card-text small">{{ publication.description }}</p>
                            </div>
                            
                            <div class="card-footer bg-transparent">
                                <small class="text-muted">
                                    <i class="bi bi-heart"></i> {{ publication.likes|length }}
                                    <i class="bi bi-chat ms-2"></i> {{ publication.comments|length }}
                                </small>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        {% endfor %}
    </div>
{% endif %}
{% endblock %}