{% extends 'base.html.twig' %}

{% block title %}Accueil - Instagrume{% endblock %}

{% block body %}
{# Header de la page d'accueil #}
<div class="text-center" style="margin-bottom: var(--spacing-2xl);">
    <h1 style="font-size: var(--font-size-4xl); font-weight: 700; color: var(--color-text-primary); margin-bottom: var(--spacing-sm);">
        Instagrume
    </h1>
    <p style="font-size: var(--font-size-lg); color: var(--color-text-muted); max-width: 600px; margin: 0 auto;">
        Partagez vos fruits et légumes préférés avec la communauté
    </p>
</div>

{% if publications is empty %}
    {# État vide #}
    <div class="card" style="max-width: 600px; margin: 0 auto; text-align: center;">
        <div class="card-body" style="padding: var(--spacing-3xl);">
            <i class="bi bi-inbox" style="font-size: 4rem; color: var(--color-primary); margin-bottom: var(--spacing-lg);"></i>
            <h3 style="margin-bottom: var(--spacing-md);">Aucune publication pour le moment</h3>
            <p class="text-muted" style="margin-bottom: var(--spacing-xl);">
                {% if app.session.get('token') %}
                    Soyez le premier à partager vos fruits et légumes préférés !
                {% else %}
                    Connectez-vous pour commencer à partager !
                {% endif %}
            </p>
            {% if app.session.get('token') %}
                <a href="{{ path('app_publication_create') }}" class="btn btn-primary btn-lg">
                    <i class="bi bi-plus-circle"></i>
                    Créer ma première publication
                </a>
            {% else %}
                <a href="{{ path('app_login') }}" class="btn btn-primary btn-lg">
                    <i class="bi bi-box-arrow-in-right"></i>
                    Se connecter
                </a>
            {% endif %}
        </div>
    </div>
{% else %}
    {# Grille de publications #}
    <div class="publications-grid">
        {% for publication in publications %}
            <a href="{{ path('app_publication_view', {id: publication.id}) }}" style="text-decoration: none; color: inherit;">
                <article class="publication-card">
                    {# Image de la publication #}
                    {% if publication.images is not empty %}
                        <img 
                            src="https://127.0.0.1:3000{{ publication.images[0].url }}" 
                            alt="{{ publication.description }}"
                            class="publication-image"
                        >
                    {% else %}
                        <div class="publication-image" style="background: linear-gradient(135deg, var(--amber-3), var(--amber-5)); display: flex; align-items: center; justify-content: center;">
                            <i class="bi bi-image" style="font-size: 3rem; color: var(--amber-8);"></i>
                        </div>
                    {% endif %}
                    
                    {# Info de la publication #}
                    <div class="publication-info">
                        {# Auteur #}
                        <div style="display: flex; align-items: center; gap: var(--spacing-sm); margin-bottom: var(--spacing-sm);">
                            {% if publication.user.images is defined and publication.user.images is not empty %}
                                <img 
                                    src="https://127.0.0.1:3000{{ publication.user.images[0].url }}" 
                                    alt="{{ publication.user.username }}"
                                    style="width: 32px; height: 32px; border-radius: var(--radius-full); object-fit: cover; border: 2px solid var(--color-primary);"
                                >
                            {% else %}
                                <i class="bi bi-person-circle" style="font-size: 2rem; color: var(--color-primary);"></i>
                            {% endif %}
                            <span style="font-weight: 600; color: var(--color-text-primary);">
                                {{ publication.user.username }}
                            </span>
                        </div>
                        
                        {# Description (tronquée) #}
                        <p style="color: var(--color-text-secondary); font-size: var(--font-size-sm); line-height: 1.5; margin: 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                            {{ publication.description }}
                        </p>
                        
                        {# Stats #}
                        <div style="display: flex; gap: var(--spacing-lg); margin-top: var(--spacing-md); font-size: var(--font-size-sm); color: var(--color-text-muted);">
                            <span>
                                <i class="bi bi-heart"></i>
                                {{ publication.likes|length }}
                            </span>
                            <span>
                                <i class="bi bi-chat"></i>
                                {{ publication.comments|length }}
                            </span>
                        </div>
                    </div>
                </article>
            </a>
        {% endfor %}
    </div>
{% endif %}
{% endblock %}
