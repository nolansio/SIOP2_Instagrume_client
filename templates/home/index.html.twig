{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
<div class="container-instagram">
    {# Message d'erreur si problème API #}
    {% if error %}
        <div class="alert alert-instagram alert-danger d-flex align-items-start gap-3">
            <i class="bi bi-exclamation-triangle-fill fs-4"></i>
            <div class="flex-grow-1">
                <strong>Erreur de connexion à l'API</strong>
                <p class="mb-1 mt-2">{{ error }}</p>
                <small class="text-muted">
                    <i class="bi bi-info-circle me-1"></i>
                    Vérifiez que l'API est bien lancée sur http://localhost:3000
                </small>
            </div>
        </div>
    {% endif %}

    {# État vide - Pas de publications #}
    {% if isEmpty and not error %}
        <div class="empty-state fade-in">
            <i class="bi bi-camera"></i>
            <h3>Aucune publication pour le moment</h3>
            <p>Soyez le premier à partager vos fruits et légumes préférés !</p>
            
            {% if isConnected %}
                <a href="{{ path('app_publication_new') }}" class="btn btn-instagram">
                    <i class="bi bi-plus-circle"></i>
                    Créer ma première publication
                </a>
            {% else %}
                <div class="d-flex gap-2 justify-content-center">
                    <a href="{{ path('app_security_login') }}" class="btn btn-instagram">
                        <i class="bi bi-box-arrow-in-right"></i>
                        Se connecter
                    </a>
                    <a href="{{ path('app_security_register') }}" class="btn btn-instagram-outline">
                        <i class="bi bi-person-plus"></i>
                        S'inscrire
                    </a>
                </div>
            {% endif %}
        </div>
    {% endif %}

    {# Feed des publications #}
    {% if publications is not empty %}
        <div class="row justify-content-center">
            <div class="col-12 col-md-10 col-lg-8 col-xl-7">
                {# En-tête du feed #}
                <div class="d-flex justify-content-between align-items-center mb-4 fade-in">
                    <h2 class="h5 mb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-images text-primary-custom"></i>
                        Publications récentes
                    </h2>
                    <span class="badge badge-instagram">
                        {{ publications|length }} publication{{ publications|length > 1 ? 's' : '' }}
                    </span>
                </div>

                {# Liste des publications #}
                {% for publication in publications %}
                    <article class="publication-card-instagram fade-in" style="animation-delay: {{ loop.index0 * 0.1 }}s">
                        {# Header - Informations utilisateur #}
                        <div class="publication-header">
                            <div class="publication-avatar">
                                {{ publication.user.username|default('?')|first|upper }}
                            </div>
                            <div class="publication-user-info">
                                <div class="publication-username">
                                    <a href="{{ path('app_user_profile', {id: publication.user.id|default(1)}) }}" class="text-decoration-none text-dark">
                                        {{ publication.user.username|default('Utilisateur inconnu') }}
                                    </a>
                                </div>
                                <div class="publication-date">
                                    {% if publication.created_at is defined %}
                                        {{ publication.created_at|date('d/m/Y à H:i') }}
                                    {% else %}
                                        Il y a quelques instants
                                    {% endif %}
                                </div>
                            </div>
                            {# Menu 3 points (à implémenter plus tard) #}
                            <button class="action-btn ms-auto">
                                <i class="bi bi-three-dots"></i>
                            </button>
                        </div>

                        {# Image de la publication #}
                        {% if publication.image_url is defined and publication.image_url %}
                            <img src="{{ publication.image_url }}" 
                                 class="publication-image" 
                                 alt="Publication de {{ publication.user.username|default('utilisateur') }}"
                                 loading="lazy">
                        {% else %}
                            {# Images placeholder variées #}
                            {% set placeholders = [
                                'https://images.unsplash.com/photo-1610832958506-aa56368176cf?w=800&h=800&fit=crop',
                                'https://images.unsplash.com/photo-1556912172-45b7abe8b7e1?w=800&h=800&fit=crop',
                                'https://images.unsplash.com/photo-1566385101042-1a0aa0c1268c?w=800&h=800&fit=crop',
                                'https://images.unsplash.com/photo-1619566636858-adf3ef46400b?w=800&h=800&fit=crop',
                                'https://images.unsplash.com/photo-1518843875459-f738682238a6?w=800&h=800&fit=crop'
                            ] %}
                            <img src="{{ placeholders[loop.index0 % 5] }}" 
                                 class="publication-image" 
                                 alt="Fruits et légumes"
                                 loading="lazy">
                        {% endif %}

                        {# Actions (likes, commentaires, partage) #}
                        <div class="publication-actions">
                            <button class="action-btn" title="J'aime">
                                <i class="bi bi-heart"></i>
                            </button>
                            <button class="action-btn" title="Commenter">
                                <i class="bi bi-chat"></i>
                            </button>
                            <button class="action-btn" title="Partager">
                                <i class="bi bi-share"></i>
                            </button>
                            <button class="action-btn ms-auto" title="Enregistrer">
                                <i class="bi bi-bookmark"></i>
                            </button>
                        </div>

                        {# Nombre de likes #}
                        <div class="publication-stats">
                            <span>{{ publication.likes|default([])|length }}</span> 
                            {% if publication.likes|default([])|length > 1 %}
                                mentions J'aime
                            {% else %}
                                mention J'aime
                            {% endif %}
                        </div>

                        {# Description #}
                        {% if publication.description %}
                            <div class="publication-description">
                                <span class="username">{{ publication.user.username|default('Utilisateur') }}</span>
                                {{ publication.description }}
                            </div>
                        {% endif %}

                        {# Preview des commentaires #}
                        {% if publication.comments|default([])|length > 0 %}
                            <div class="publication-comments-preview">
                                <a href="{{ path('app_publication_show', {id: publication.id}) }}" class="view-comments text-decoration-none">
                                    Afficher les {{ publication.comments|length }} commentaire{{ publication.comments|length > 1 ? 's' : '' }}
                                </a>
                            </div>
                        {% endif %}

                        {# Ajouter un commentaire #}
                        <div class="add-comment">
                            <i class="bi bi-emoji-smile" style="color: var(--text-secondary); cursor: pointer;"></i>
                            <input type="text" 
                                   placeholder="Ajouter un commentaire..." 
                                   {% if not isConnected %}disabled{% endif %}>
                            <button type="button" {% if not isConnected %}disabled{% endif %}>
                                Publier
                            </button>
                        </div>
                    </article>
                {% endfor %}

                {# Fin du feed #}
                <div class="text-center py-4 text-muted">
                    <i class="bi bi-check-circle-fill text-primary-custom me-2"></i>
                    Vous êtes à jour !
                </div>
            </div>

            {# Sidebar (suggestions, etc.) - Desktop uniquement #}
            <div class="col-lg-4 d-none d-xl-block">
                <div class="sticky-top" style="top: calc(var(--navbar-height) + 30px);">
                    {# Profil utilisateur #}
                    {% if isConnected %}
                        <div class="bg-white p-3 rounded-3 border mb-3">
                            <div class="d-flex align-items-center gap-3">
                                <div class="publication-avatar" style="width: 56px; height: 56px; font-size: 1.2rem;">
                                    {{ app.session.get('username')|default('U')|first|upper }}
                                </div>
                                <div class="flex-grow-1">
                                    <div class="fw-bold">{{ app.session.get('username')|default('Utilisateur') }}</div>
                                    <div class="text-muted small">Voir mon profil</div>
                                </div>
                                <a href="{{ path('app_user_profile') }}" class="text-primary-custom fw-bold small text-decoration-none">
                                    Voir
                                </a>
                            </div>
                        </div>
                    {% endif %}

                    {# Suggestions #}
                    <div class="bg-white p-3 rounded-3 border mb-3">
                        <h6 class="text-muted mb-3">Suggestions pour vous</h6>
                        <div class="d-flex flex-column gap-3">
                            {% for i in 1..3 %}
                                <div class="d-flex align-items-center gap-2">
                                    <div class="publication-avatar" style="width: 32px; height: 32px; font-size: 0.8rem;">
                                        U{{ i }}
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="small fw-bold">user{{ i }}</div>
                                        <div class="text-muted" style="font-size: 0.75rem;">Suggéré pour vous</div>
                                    </div>
                                    <button class="btn btn-sm text-primary-custom fw-bold p-0 border-0 bg-transparent">
                                        Suivre
                                    </button>
                                </div>
                            {% endfor %}
                        </div>
                    </div>

                    {# À propos #}
                    <div class="text-muted small">
                        <div class="d-flex flex-wrap gap-2 mb-2">
                            <a href="#" class="text-muted text-decoration-none">À propos</a>
                            <a href="#" class="text-muted text-decoration-none">Aide</a>
                            <a href="#" class="text-muted text-decoration-none">Conditions</a>
                        </div>
                        <div>© {{ "now"|date("Y") }} INSTAGRUME - BTS SIO</div>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
</div>

{# Script pour les interactions (likes, commentaires, etc.) #}
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Animation des likes
    document.querySelectorAll('.action-btn').forEach(btn => {
        if (btn.querySelector('.bi-heart')) {
            btn.addEventListener('click', function() {
                const icon = this.querySelector('i');
                if (icon.classList.contains('bi-heart')) {
                    icon.classList.remove('bi-heart');
                    icon.classList.add('bi-heart-fill');
                    this.classList.add('liked', 'pulse');
                } else {
                    icon.classList.remove('bi-heart-fill');
                    icon.classList.add('bi-heart');
                    this.classList.remove('liked');
                }
                setTimeout(() => this.classList.remove('pulse'), 500);
            });
        }
    });

    // Double-tap pour liker (mobile)
    let lastTap = 0;
    document.querySelectorAll('.publication-image').forEach(img => {
        img.addEventListener('click', function(e) {
            const currentTime = new Date().getTime();
            const tapLength = currentTime - lastTap;
            if (tapLength < 300 && tapLength > 0) {
                // Double tap détecté
                const card = this.closest('.publication-card-instagram');
                const likeBtn = card.querySelector('.action-btn .bi-heart');
                if (likeBtn && !likeBtn.classList.contains('bi-heart-fill')) {
                    likeBtn.classList.remove('bi-heart');
                    likeBtn.classList.add('bi-heart-fill');
                    likeBtn.closest('.action-btn').classList.add('liked', 'pulse');
                }
            }
            lastTap = currentTime;
        });
    });
});
</script>
{% endblock %}
