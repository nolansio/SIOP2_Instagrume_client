{% extends 'base.html.twig' %}

{% block title %}Mon Profil - Instagrume{% endblock %}

{% block body %}
<div class="row">
    <div class="col-md-4">
        <div class="card shadow">
            <div class="card-body text-center">
                <i class="bi bi-person-circle text-success" style="font-size: 8rem;"></i>
                <h3 class="mt-3">{{ user.username }}</h3>
                <p class="text-muted">
                    {% if 'ROLE_ADMIN' in user.roles %}
                        <span class="badge bg-danger">Administrateur</span>
                    {% elseif 'ROLE_MOD' in user.roles %}
                        <span class="badge bg-warning">Modérateur</span>
                    {% else %}
                        <span class="badge bg-secondary">Utilisateur</span>
                    {% endif %}
                </p>
                <hr>
                <p><strong>{{ publications|length }}</strong> publications</p>
                <p><strong>{{ user.comments|length }}</strong> commentaires</p>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <h3 class="mb-4">Mes Publications</h3>
        
        {% if publications is empty %}
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> Vous n'avez pas encore de publications.
                <a href="{{ path('app_publication_create') }}" class="alert-link">Créer une publication</a>
            </div>
        {% else %}
            <div class="list-group">
                {% for publication in publications %}
                    <div class="list-group-item">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="flex-grow-1">
                                <h5 class="mb-1">{{ publication.description|slice(0, 100) }}{% if publication.description|length > 100 %}...{% endif %}</h5>
                                <small class="text-muted">
                                    <i class="bi bi-calendar"></i> {{ publication.created_at|date('d/m/Y à H:i') }}
                                    <i class="bi bi-heart ms-3"></i> {{ publication.likes|length }}
                                    <i class="bi bi-chat ms-2"></i> {{ publication.comments|length }}
                                </small>
                            </div>
                            <div>
                                <a href="{{ path('app_publication_view', {id: publication.id}) }}" class="btn btn-sm btn-primary">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a href="{{ path('app_publication_edit', {id: publication.id}) }}" class="btn btn-sm btn-warning">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form method="post" action="{{ path('app_publication_delete', {id: publication.id}) }}" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-danger"
                                            onclick="return confirm('Supprimer cette publication ?')">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}