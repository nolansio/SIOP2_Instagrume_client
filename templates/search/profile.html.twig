{% extends 'base.html.twig' %}

{% block title %}{{ user.username }} - Instagrume{% endblock %}

{% block body %}
<div style="max-width: 1000px; margin: 0 auto;">
    {# En-tête du profil #}
    <div class="card" style="margin-bottom: var(--spacing-xl);">
        <div class="card-body" style="padding: var(--spacing-2xl);">
            <div style="display: flex; align-items: center; gap: var(--spacing-2xl); flex-wrap: wrap;">
                {# Avatar #}
                <div style="flex-shrink: 0;">
                    {% if user.images is not empty %}
                        <img 
                            src="https://127.0.0.1:3000{{ user.images[0].url }}" 
                            alt="{{ user.username }}" 
                            style="width: 120px; height: 120px; border-radius: var(--radius-full); object-fit: cover; border: 3px solid var(--color-primary);"
                        >
                    {% else %}
                        <div style="width: 120px; height: 120px; border-radius: var(--radius-full); background: linear-gradient(135deg, var(--amber-5), var(--amber-7)); display: flex; align-items: center; justify-content: center;">
                            <i class="bi bi-person" style="font-size: 4rem; color: white;"></i>
                        </div>
                    {% endif %}
                </div>
                
                {# Informations #}
                <div style="flex: 1; min-width: 250px;">
                    <div style="display: flex; align-items: center; gap: var(--spacing-md); margin-bottom: var(--spacing-md); flex-wrap: wrap;">
                        <h1 style="font-size: var(--font-size-3xl); margin: 0;">{{ user.username }}</h1>
                        
                        {# Badges de rôle #}
                        {% if 'ROLE_ADMIN' in user.roles %}
                            <span class="badge badge-admin">
                                <i class="bi bi-shield-fill"></i>
                                Admin
                            </span>
                        {% elseif 'ROLE_MOD' in user.roles %}
                            <span class="badge badge-mod">
                                <i class="bi bi-shield"></i>
                                Modérateur
                            </span>
                        {% endif %}
                        
                        {# Badge banni #}
                        {% if is_banned(user) %}
                            <span class="badge badge-banned">
                                <i class="bi bi-ban"></i>
                                Banni
                            </span>
                        {% endif %}
                    </div>
                    
                    {# Stats #}
                    <div style="display: flex; gap: var(--spacing-xl); margin-bottom: var(--spacing-lg);">
                        <div>
                            <span style="font-weight: 700; font-size: var(--font-size-xl); color: var(--color-text-primary);">
                                {{ publications|length }}
                            </span>
                            <span class="text-muted" style="font-size: var(--font-size-sm);">publications</span>
                        </div>
                    </div>
                    
                    {# Bouton édition si c'est son profil #}
                    {% if app.session.get('user') and app.session.get('user').username == user.username %}
                        <a href="{{ path('app_profile_edit') }}" class="btn btn-secondary">
                            <i class="bi bi-pencil"></i>
                            <span>Modifier mon profil</span>
                        </a>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
    
    {# Grille de publications #}
    <div>
        <h2 style="margin-bottom: var(--spacing-lg);">Publications</h2>
        
        {% if publications is empty %}
            <div class="card">
                <div class="card-body" style="text-align: center; padding: var(--spacing-3xl);">
                    <i class="bi bi-inbox" style="font-size: 3rem; color: var(--color-primary); margin-bottom: var(--spacing-md);"></i>
                    <h3 style="color: var(--color-text-secondary); margin-bottom: var(--spacing-sm);">Aucune publication</h3>
                    <p class="text-muted">
                        {% if app.session.get('user') and app.session.get('user').username == user.username %}
                            Commencez à partager vos fruits et légumes préférés !
                        {% else %}
                            Cet utilisateur n'a pas encore publié de contenu.
                        {% endif %}
                    </p>
                    {% if app.session.get('user') and app.session.get('user').username == user.username %}
                        <a href="{{ path('app_publication_create') }}" class="btn btn-primary" style="margin-top: var(--spacing-md);">
                            <i class="bi bi-plus-circle"></i>
                            Créer ma première publication
                        </a>
                    {% endif %}
                </div>
            </div>
        {% else %}
            <div class="publications-grid">
                {% for publication in publications %}
                    <a href="{{ path('app_publication_view', {id: publication.id}) }}" style="text-decoration: none; color: inherit;">
                        <article class="publication-card">
                            {% if publication.images is not empty %}
                                <img 
                                    src="https://127.0.0.1:3000{{ publication.images[0].url }}" 
                                    alt="{{ publication.description }}"
                                    class="publication-image"
                                >
                            {% else %}
                                <div class="publication-image" style="background: linear-gradient(135deg, var(--amber-3), var(--amber-5)); display: flex; align-items: center; justify-content: center;">
                                    <i class="bi bi-image" style="font-size: 3rem; color: var(--amber-8);"></i>
                                </div>
                            {% endif %}
                            
                            <div class="publication-info">
                                <p style="color: var(--color-text-secondary); font-size: var(--font-size-sm); line-height: 1.5; margin: 0 0 var(--spacing-sm) 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                    {{ publication.description }}
                                </p>
                                
                                <div style="display: flex; gap: var(--spacing-lg); font-size: var(--font-size-sm); color: var(--color-text-muted);">
                                    <span>
                                        <i class="bi bi-heart"></i>
                                        {{ publication.likes|length }}
                                    </span>
                                    <span>
                                        <i class="bi bi-chat"></i>
                                        {{ publication.comments|length }}
                                    </span>
                                </div>
                            </div>
                        </article>
                    </a>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
