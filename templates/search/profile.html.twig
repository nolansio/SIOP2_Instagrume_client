{% extends 'base.html.twig' %}

{% block title %}{{ user.username }} - Instagrume{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-10">
        {# En-tête du profil #}
        <div class="card shadow-lg mb-4">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-auto">
                        {% if user.images is not empty %}
                            <img src="https://127.0.0.1:3000{{ user.images[0].url }}" 
                                 alt="{{ user.username }}" 
                                 class="rounded-circle"
                                 style="width: 100px; height: 100px; object-fit: cover;">
                        {% else %}
                            <i class="bi bi-person-circle text-success" style="font-size: 100px;"></i>
                        {% endif %}
                    </div>
                    <div class="col">
                        <h2 class="mb-2">
                            {{ user.username }}
                            {% if 'ROLE_ADMIN' in user.roles %}
                                <span class="badge bg-danger ms-2">Admin</span>
                            {% elseif 'ROLE_MOD' in user.roles %}
                                <span class="badge bg-warning ms-2">Modérateur</span>
                            {% endif %}
                            {% if is_banned(user) %}
                                <span class="badge bg-dark ms-2">
                                    <i class="bi bi-ban"></i> Banni
                                </span>
                            {% endif %}
                        </h2>
                        <p class="text-muted mb-0">
                            <i class="bi bi-calendar"></i> 
                            Membre depuis {{ user.created_at|default('now')|date('F Y') }}
                        </p>
                        <p class="text-muted">
                            <i class="bi bi-file-earmark-text"></i> 
                            {{ user.publications|length }} publication(s)
                        </p>
                    </div>
                    {% if app.session.get('user') and app.session.get('user').username == user.username %}
                        <div class="col-auto">
                            <a href="{{ path('app_profile_edit') }}" class="btn btn-primary">
                                <i class="bi bi-pencil"></i> Modifier le profil
                            </a>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        {# Publications de l'utilisateur #}
        <h3 class="mb-3">Publications</h3>
        
        {% if user.publications is not empty %}
            <div class="row row-cols-1 row-cols-md-3 g-4">
                {% for publication in user.publications %}
                    <div class="col">
                        <div class="card h-100 shadow-sm">
                            {% if publication.images is not empty %}
                                <img src="https://127.0.0.1:3000{{ publication.images[0].url }}" 
                                     class="card-img-top" 
                                     alt="{{ publication.description }}"
                                     style="height: 200px; object-fit: cover;">
                            {% endif %}
                            <div class="card-body">
                                <p class="card-text">{{ publication.description|slice(0, 100) }}{% if publication.description|length > 100 %}...{% endif %}</p>
                                <div class="d-flex justify-content-between align-items-center">
                                    <small class="text-muted">
                                        <i class="bi bi-heart"></i> {{ publication.likes|length }}
                                        <i class="bi bi-chat ms-2"></i> {{ publication.comments|length }}
                                    </small>
                                    <a href="{{ path('app_publication_view', {id: publication.id}) }}" 
                                       class="btn btn-sm btn-outline-primary">
                                        Voir
                                    </a>
                                </div>
                            </div>
                            <div class="card-footer text-muted">
                                <small>{{ publication.created_at|date('d/m/Y à H:i') }}</small>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="alert alert-info text-center">
                <i class="bi bi-info-circle"></i> Aucune publication pour le moment.
            </div>
        {% endif %}

        <div class="text-center mt-4">
            <a href="{{ path('app_home') }}" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Retour à l'accueil
            </a>
        </div>
    </div>
</div>
{% endblock %}
