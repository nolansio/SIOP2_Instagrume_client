<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Instagrume{% endblock %}</title>

    {# Favicon SVG #}
    <link rel="icon" type="image/svg+xml" href="{{ asset('images/favicon.svg') }}">

    {# Nouveau CSS custom #}
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">

    {# Bootstrap Icons (gardés pour les icônes) #}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

    {% block stylesheets %}{% endblock %}
</head>
<body>
    {# Navigation minimaliste #}
    <nav class="navbar">
        <div class="container navbar-container">
            {# Logo / Brand #}
            <a href="{{ path('app_home') }}" class="navbar-brand">
                <img src="{{ asset('images/logo.png') }}" alt="Instagrume Logo" style="height: 40px; width: auto; vertical-align: middle;">
                <span>Instagrume</span>
            </a>

            {# Barre de recherche #}
            <div class="navbar-search">
                <form action="{{ path('app_search') }}" method="get">
                    <div style="position: relative;">
                        <input
                            type="search"
                            name="q"
                            placeholder="Rechercher un utilisateur..."
                            class="form-input"
                            style="padding-left: 2.5rem;"
                        >
                        <i class="bi bi-search" style="position: absolute; left: 0.75rem; top: 50%; transform: translateY(-50%); color: var(--color-text-muted);"></i>
                    </div>
                </form>
            </div>

            {# Navigation principale #}
            <ul class="navbar-nav">
                {% if app.session.get('token') %}
                    {# Bouton créer une publication #}
                    <li>
                        <a href="{{ path('app_publication_create') }}" class="btn btn-primary">
                            <span>Créer</span>
                        </a>
                    </li>

                    {# Dashboard pour mod/admin #}
                    {% if app.session.get('user') and (('ROLE_MOD' in app.session.get('user').roles) or ('ROLE_ADMIN' in app.session.get('user').roles)) %}
                        <li>
                            <a href="{{ path('app_dashboard') }}">
                                <span>Dashboard</span>
                            </a>
                        </li>
                    {% endif %}

                    {# Accueil #}
                    <li>
                        <a href="{{ path('app_home') }}">
                            <span>Accueil</span>
                        </a>
                    </li>

                    {# Profil avec avatar #}
                    <li>
                        <a href="{{ path('app_my_profile') }}" style="display: flex; align-items: center; gap: var(--spacing-sm);">
                            {# Avatar ou icône par défaut #}
                            {% if app.session.get('user') and app.session.get('user').images is not empty %}
                                <img
                                    src="{{ api_base }}{{ app.session.get('user').images[0].url }}"
                                    alt="{{ app.session.get('user').username }}"
                                    style="width: 32px; height: 32px; border-radius: var(--radius-full); object-fit: cover; border: 2px solid var(--color-primary);"
                                >
                            {% else %}
                                <i class="bi bi-person-circle"></i>
                            {% endif %}

                            <span>
                                {% if app.session.get('user') %}
                                    {{ app.session.get('user').username }}
                                {% else %}
                                    Profil
                                {% endif %}
                            </span>
                        </a>
                    </li>

                    {# Déconnexion #}
                    <li>
                        <a href="{{ path('app_logout') }}" class="btn btn-outline">
                            <i class="bi bi-box-arrow-right"></i>
                        </a>
                    </li>
                {% else %}
                    {# Connexion / Inscription #}
                    <li>
                        <a href="{{ path('app_login') }}">
                            <i class="bi bi-box-arrow-in-right"></i>
                            <span>Connexion</span>
                        </a>
                    </li>
                    <li>
                        <a href="{{ path('app_register') }}" class="btn btn-primary">
                            <i class="bi bi-person-plus"></i>
                            <span>Inscription</span>
                        </a>
                    </li>
                {% endif %}
            </ul>
        </div>
    </nav>

    {# Messages flash #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="container" style="margin-top: var(--spacing-lg);">
                <div class="alert alert-{{ label }}">
                    <i class="bi bi-{% if label == 'success' %}check-circle{% elseif label == 'danger' or label == 'error' %}exclamation-circle{% elseif label == 'warning' %}exclamation-triangle{% else %}info-circle{% endif %}"></i>
                    <span>{{ message }}</span>
                </div>
            </div>
        {% endfor %}
    {% endfor %}

    {# Contenu principal #}
    <main class="container" style="margin-top: var(--spacing-2xl); margin-bottom: var(--spacing-3xl);">
        {% block body %}{% endblock %}
    </main>

    {# Footer minimaliste #}
    <footer style="background: var(--color-surface); border-top: 1px solid var(--color-border); padding: var(--spacing-xl) 0; margin-top: auto;">
        <div class="container">
            <div style="text-align: center; color: var(--color-text-muted);">
                <p style="margin-bottom: var(--spacing-sm);">
                    <strong style="color: var(--color-primary);">Instagrume</strong> - Partagez vos fruits et légumes
                </p>
                <p style="font-size: var(--font-size-sm);">
                    © {{ "now"|date("Y") }} Instagrume. Tous droits réservés.
                </p>
            </div>
        </div>
    </footer>

    {% block javascripts %}{% endblock %}
</body>
</html>
