{% extends 'base.html.twig' %}

{% block title %}Test API - Instagrume{% endblock %}

{% block body %}
<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="text-center mb-5">
                    <i class="bi bi-gear" style="font-size: 4rem; color: var(--color-primary);"></i>
                    <h1 class="display-5 fw-bold mt-3 mb-2">Test de connexion API</h1>
                    <p class="text-muted">Vérification de la communication avec l'API Instagrume</p>
                </div>

                {# Configuration #}
                <div class="card shadow-sm border-0 mb-4" style="border-radius: 16px;">
                    <div class="card-header bg-primary-custom text-white" style="border-radius: 16px 16px 0 0;">
                        <h5 class="mb-0">
                            <i class="bi bi-sliders"></i> Configuration
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <strong>URL de l'API :</strong><br>
                                <code class="text-primary-custom">{{ results.api_url }}</code>
                            </div>
                            <div class="col-md-3 mb-3">
                                <strong>Session active :</strong><br>
                                {% if results.session_active %}
                                    <span class="badge bg-success">
                                        <i class="bi bi-check-circle"></i> Oui
                                    </span>
                                {% else %}
                                    <span class="badge bg-danger">
                                        <i class="bi bi-x-circle"></i> Non
                                    </span>
                                {% endif %}
                            </div>
                            <div class="col-md-3 mb-3">
                                <strong>Token JWT :</strong><br>
                                {% if results.token_in_session %}
                                    <span class="badge bg-success">
                                        <i class="bi bi-shield-check"></i> Présent
                                    </span>
                                {% else %}
                                    <span class="badge bg-warning">
                                        <i class="bi bi-shield-exclamation"></i> Absent
                                    </span>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>

                {# Tests API #}
                <div class="card shadow-sm border-0 mb-4" style="border-radius: 16px;">
                    <div class="card-header bg-secondary-custom text-white" style="border-radius: 16px 16px 0 0;">
                        <h5 class="mb-0">
                            <i class="bi bi-lightning-charge"></i> Tests des routes API
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        {% for test_name, test_result in results.api_tests %}
                            <div class="mb-4 p-3 border rounded-3 {% if test_result.status == 'SUCCESS' %}border-success bg-light{% elseif test_result.status == 'ERROR' %}border-danger bg-light{% else %}border-warning bg-light{% endif %}">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h6 class="mb-0">
                                        <i class="bi bi-arrow-right-circle"></i>
                                        {{ test_name|replace({'_': ' '})|title }}
                                    </h6>
                                    {% if test_result.status == 'SUCCESS' %}
                                        <span class="badge bg-success">
                                            <i class="bi bi-check-lg"></i> SUCCESS
                                        </span>
                                    {% elseif test_result.status == 'ERROR' %}
                                        <span class="badge bg-danger">
                                            <i class="bi bi-x-lg"></i> ERROR
                                        </span>
                                    {% else %}
                                        <span class="badge bg-warning">
                                            <i class="bi bi-dash-lg"></i> SKIPPED
                                        </span>
                                    {% endif %}
                                </div>

                                {% if test_result.status == 'SUCCESS' %}
                                    <div class="mt-2">
                                        {% if test_result.count is defined %}
                                            <small class="text-muted">
                                                <i class="bi bi-database"></i> 
                                                <strong>{{ test_result.count }}</strong> résultat(s) trouvé(s)
                                            </small>
                                        {% endif %}
                                        
                                        {% if test_result.username is defined %}
                                            <br>
                                            <small class="text-muted">
                                                <i class="bi bi-person"></i>
                                                Connecté en tant que : <strong>{{ test_result.username }}</strong>
                                            </small>
                                        {% endif %}

                                        {% if test_result.sample is defined and test_result.sample %}
                                            <div class="mt-2 p-2 bg-white rounded border">
                                                <small>
                                                    <strong>Exemple :</strong><br>
                                                    ID: {{ test_result.sample.id }}<br>
                                                    Description: {{ test_result.sample.description }}
                                                </small>
                                            </div>
                                        {% endif %}
                                    </div>
                                {% elseif test_result.status == 'ERROR' %}
                                    <div class="mt-2">
                                        <small class="text-danger">
                                            <i class="bi bi-exclamation-triangle"></i>
                                            {{ test_result.message }}
                                        </small>
                                    </div>
                                {% else %}
                                    <div class="mt-2">
                                        <small class="text-muted">
                                            {{ test_result.message }}
                                        </small>
                                    </div>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                </div>

                {# Données utilisateur si connecté #}
                {% if results.user_data is defined and results.user_data %}
                    <div class="card shadow-sm border-0 mb-4" style="border-radius: 16px;">
                        <div class="card-header bg-success text-white" style="border-radius: 16px 16px 0 0;">
                            <h5 class="mb-0">
                                <i class="bi bi-person-circle"></i> Données utilisateur en session
                            </h5>
                        </div>
                        <div class="card-body p-4">
                            <pre class="bg-light p-3 rounded">{{ results.user_data|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
                        </div>
                    </div>
                {% endif %}

                {# Actions #}
                <div class="text-center">
                    <a href="{{ path('app_home') }}" class="btn btn-outline-primary me-2">
                        <i class="bi bi-house"></i> Retour à l'accueil
                    </a>
                    
                    {% if not results.token_in_session %}
                        <a href="{{ path('app_login') }}" class="btn btn-primary me-2">
                            <i class="bi bi-box-arrow-in-right"></i> Se connecter
                        </a>
                    {% endif %}

                    <a href="{{ path('app_test_api') }}" class="btn btn-secondary">
                        <i class="bi bi-arrow-clockwise"></i> Rafraîchir
                    </a>
                </div>

                {# Aide #}
                <div class="alert alert-info mt-5">
                    <h6><i class="bi bi-info-circle"></i> Comment résoudre les erreurs ?</h6>
                    <ul class="mb-0">
                        <li><strong>Connection refused :</strong> Vérifiez que l'API est bien lancée sur le port {{ results.api_url }}</li>
                        <li><strong>404 Not Found :</strong> Vérifiez l'URL de l'API dans votre fichier .env</li>
                        <li><strong>401 Unauthorized :</strong> Votre token JWT est invalide ou expiré, reconnectez-vous</li>
                        <li><strong>Session non active :</strong> Vérifiez la configuration des sessions dans config/packages/framework.yaml</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    pre {
        max-height: 400px;
        overflow-y: auto;
    }
    
    code {
        background-color: rgba(45, 80, 22, 0.1);
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
    }
</style>
{% endblock %}
