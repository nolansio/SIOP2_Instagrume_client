{# Script de recherche (à améliorer plus tard avec AJAX) #}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('searchInput');
    if (searchInput) {
        searchInput.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                const searchValue = this.value.trim();
                if (searchValue) {
                    window.location.href = '{{ path('app_user_search_profile') }}?q=' + encodeURIComponent(searchValue);
                }
            }
        });
    }
});
</script>
